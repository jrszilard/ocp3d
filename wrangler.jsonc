// The site on Cloudflare Workers: the static pages from ./dist (served before the Worker runs),
// and the Astro server routes (/api/request, /unsubscribe) in the Worker.
//   Deploy:  scripts/deploy.sh (builds HEAD from a clean export, never the working tree)
//   Logs:    npx wrangler tail ocp3d
// Settings are Worker secrets, never in this file: npx wrangler secret put <NAME> for
// AGENTMAIL_API_KEY, AGENTMAIL_INBOX_ID, REQUESTS_NOTIFY_EMAIL, UNSUBSCRIBE_SECRET and
// (optional) REQUESTS_WEBHOOK_URL. No database: requests, signups and opt-outs are emails.
// The old and www hostnames redirect from their own Worker: workers/redirects/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocp3d",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // ocp3d.com itself; www and the old domains belong to the redirect Worker. No workers.dev
  // address or per-version preview addresses: the site has one public home.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ocp3d.com", "custom_domain": true }
  ]
}
