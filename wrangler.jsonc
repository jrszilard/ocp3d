// The site on Cloudflare Workers: the static pages from ./dist (served before the Worker runs),
// and the Astro server routes (/api/request, /api/demand, /unsubscribe) in the Worker.
//   Deploy:  npm run build && npx wrangler deploy
//   Logs:    npx wrangler tail ocp3d
// Settings are Worker secrets, never in this file: npx wrangler secret put <NAME> for
// SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, UNSUBSCRIBE_SECRET, AGENTMAIL_API_KEY,
// AGENTMAIL_INBOX_ID, REQUESTS_NOTIFY_EMAIL and (optional) REQUESTS_WEBHOOK_URL.
// The old and www hostnames redirect from their own Worker: workers/redirects/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocp3d",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
