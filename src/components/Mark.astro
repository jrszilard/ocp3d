---
// THE MINISTRY MARK — "The Department", printed (identity study 04 dir. 08 + variant 11).
//
// A flat departmental tile: MDP knocked out of a solid block, built up in visible layer
// courses. The Ministry wears a real government department's flat uniform, but a perfectly
// crisp tile is the one thing this workshop cannot produce — so the block shows how it was
// actually made. No crown sits above it, ever: that absence is both the joke (we appointed
// ourselves) and what keeps us clear of impersonating a real department.
//
// PRINTED INK, NOT ENAMEL. The tile takes the page's ink through `currentColor`; the letters
// AND the layer seams knock out to the page ground, so the whole mark repaints with the theme.
// Where it must carry its own color and cannot read the page (favicon, letterhead, anything
// physical) it takes badge oxblood — see `public/favicon.svg` and the logo section of BRAND.md.
//
// The seams are ground-coloured hairlines, so they close up as the mark shrinks: by 16 px it
// collapses back to a solid departmental block, which is the intended favicon behaviour.
//
// `knockout` overrides the letter/seam color for placement on a panel or a paint tile.
const { size = 32, knockout = "var(--bg)", title = "Ministry of Discontinued Parts" } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={title}>
  <rect x="0" y="0" width="100" height="100" fill="currentColor"></rect>
  <path d="M0 9 H100 M0 18 H100 M0 27 H100 M0 36 H100 M0 45 H100 M0 54 H100 M0 63 H100 M0 72 H100 M0 81 H100 M0 90 H100"
        stroke={knockout} stroke-width="1.2" fill="none"></path>
  <text x="50" y="63" text-anchor="middle" font-family="var(--font-body)" font-weight="700"
        font-size="34" letter-spacing="0.5" fill={knockout}>MDP</text>
</svg>
