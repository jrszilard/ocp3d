---
/**
 * A docked inspection unit, not a character: fixed base, articulated physical
 * scan arm, and a small fixture head. It appears sparingly where a measurement
 * or record state benefits from a mechanical-service cue.
 */
interface Props { size?: number; label?: string }
const { size = 58, label = "Docked bench inspection unit" } = Astro.props;
---
<svg
  class="bench-unit"
  width={size}
  height={Math.round(size * .68)}
  viewBox="0 0 88 60"
  role="img"
  aria-label={label}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M4 53H64V57H4V53Z" fill="currentColor" opacity=".92" />
  <path d="M13 53V41H40V53" fill="var(--desert-dusk)" stroke="var(--paper)" stroke-width="2" />
  <path d="M23 41V27L40 19L52 30" stroke="currentColor" stroke-width="4" stroke-linecap="square" />
  <circle cx="23" cy="27" r="5" fill="var(--signal)" />
  <circle cx="40" cy="19" r="5" fill="var(--acid)" />
  <path d="M52 30L66 20" stroke="currentColor" stroke-width="4" stroke-linecap="square" />
  <path d="M65 16V25H82V16H65Z" fill="var(--desert-dusk)" stroke="var(--paper)" stroke-width="2" />
  <path d="M69 20H78" stroke="var(--signal)" stroke-width="2.5" />
  <path d="M3 59H86" stroke="var(--signal)" stroke-width="2" />
</svg>

<style>
  .bench-unit { display: block; color: var(--ion-light); }
</style>
