---
/** OCP3D lockup: retrofit-station mark + acronym + the plain-language expansion. */
import Insignia from "./Insignia.astro";
interface Props { variant?: "landscape" | "portrait" }
const { variant = "landscape" } = Astro.props;
const portrait = variant === "portrait";
---
<span class={`lockup ${portrait ? "is-portrait" : "is-landscape"}`}>
  <Insignia size={portrait ? 92 : 50} />
  <span class="name">
    <span class="acronym">OCP3D</span>
    <span class="expansion">OLD CAR PROBLEMS</span>
  </span>
</span>

<style>
  .lockup { display: flex; align-items: center; gap: 13px; color: var(--paper); }
  .is-portrait { flex-direction: column; gap: 12px; text-align: center; }
  .name { display: flex; flex-direction: column; line-height: 1; }
  .acronym {
    font-family: var(--font-display); font-weight: 700; letter-spacing: .035em;
    font-size: var(--word-land); color: var(--paper);
  }
  .expansion {
    margin-top: 6px; font-family: var(--font-mono); font-size: var(--t-micro);
    letter-spacing: .18em; color: var(--ion); white-space: nowrap;
  }
  .name::after {
    content: ""; display: block; width: 100%; height: 2px; margin-top: 7px;
    background: linear-gradient(90deg, var(--signal), var(--ion));
  }
  .is-portrait .acronym { font-size: var(--word-port); }
  .is-portrait .expansion { font-size: var(--t-eyebrow); }
</style>
