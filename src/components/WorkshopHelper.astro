---
/**
 * OCP3D workshop helper.
 *
 * A modest mid-century service cart / assembly rover: wheels, a carrying bay,
 * and a small lifting arm. It is intentionally not humanoid, conversational,
 * or AI-coded — a useful piece of shop equipment with just enough character
 * to belong in Orbital Service.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 84, class: cls = "" } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={Math.round(size * 0.625)}
  viewBox="0 0 160 100"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- carrying arm: a simple mechanical linkage, not a humanoid limb -->
  <path d="M96 54V30H118L128 18" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="128" cy="18" r="4" stroke="currentColor" stroke-width="2.5" />
  <path d="M132 15L140 18L133 23M140 18V33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <!-- low service-cart body and canopy -->
  <path d="M21 67L28 48H94L112 56V73H21V67Z" fill="currentColor" fill-opacity=".16" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
  <path d="M49 48L58 35H80L91 48" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
  <path d="M60 45H79" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <!-- tool tray and a single physical service lamp -->
  <path d="M31 56H47V63H31" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  <circle cx="42" cy="56" r="3" fill="currentColor" />
  <!-- rolling gear: four equal wheels make it a shop carriage, not a character -->
  <circle cx="43" cy="75" r="11" fill="var(--ground-deep)" stroke="currentColor" stroke-width="3" />
  <circle cx="93" cy="75" r="11" fill="var(--ground-deep)" stroke="currentColor" stroke-width="3" />
  <path d="M43 71V79M39 75H47M93 71V79M89 75H97" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <!-- three layer courses: workshop fabrication remains the point -->
  <path d="M116 67H143M120 73H140M124 79H137" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".85" />
</svg>

<style>
  svg { display: block; max-width: 100%; }
</style>
