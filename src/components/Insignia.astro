---
/**
 * OCP3D High Desert Retrofit mark.
 *
 * An original station glyph: service rail, fixture head, and three additive
 * courses. It intentionally avoids a generic car silhouette; the record and
 * real evidence, not a decorative vehicle, carry the vehicle story.
 */
interface Props {
  size?: number;
  knockout?: string;
  class?: string;
}
const { size = 48, knockout = "var(--ground)", class: cls = "" } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="OCP3D retrofit station mark"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="7" y="8" width="50" height="42" stroke="currentColor" stroke-width="2" />
  <path d="M14 18H50M18 18V37M46 18V37" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
  <path d="M23 37V29L32 24L40 31" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
  <circle cx="23" cy="29" r="2.8" fill="currentColor" />
  <circle cx="32" cy="24" r="2.8" fill="currentColor" />
  <path d="M40 31L46 26" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
  <rect x="45" y="23" width="7" height="7" fill={knockout} stroke="currentColor" stroke-width="1.6" />
  <path d="M16 42H47" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
  <path d="M18 54H46M21 58H43M24 62H40" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
</svg>
