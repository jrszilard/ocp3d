---
/**
 * One evidence-bearing part card, shared by home and the parts page.
 *
 * It intentionally refuses a decorative generic car or invented part image.
 * A safety-gated record gets its own closed treatment (labelled by closedLabel): a real
 * photo captioned "in long-term testing · not for sale" when there is one, otherwise a
 * hatched panel. A photo or render stays tied to its record, and a render says it is one.
 */
import Stamp from "./Stamp.astro";
import EvidenceLadder from "./EvidenceLadder.astro";
import PhotoCarousel from "./PhotoCarousel.astro";
import { applicationLabel, closedLabel, closedTesting, oemIdentityLabel } from "../lib/catalog";
import { partArt } from "../data/part-art.mjs";

interface Props { part: any; sheet?: number; total?: number; href?: string }
const { part } = Astro.props;
const href = Astro.props.href ?? `/registry/${part.slug}/`;

const measured = part.state === "measured";
const fitted = part.state === "fitted";
const safetyGated = Boolean(part.safetyGated);
const oemPublishable = part.oemIdentityStatus === "confirmed" && part.oemNumber;
const application = applicationLabel(part);
const closed = safetyGated ? closedLabel(part) : "";
const testing = safetyGated ? closedTesting(part) : null;
const art = partArt[part.slug as keyof typeof partArt];

const statusLabel = safetyGated
  ? closed.toUpperCase()
  : fitted
    ? "FITTED ON A REAL CAR"
    : measured
      ? `MEASURED · ${part.dimsConfirmed} DIMS`
      : part.state === "development"
        ? "IN DEVELOPMENT"
        : "REQUESTED";

const action = safetyGated
  ? (testing ? "Follow the testing" : "Why it is research only")
  : fitted
    ? "Discuss this fitted part"
    : measured
      ? "See the measurements"
      : part.state === "development"
        ? "Follow this build"
        : "Discuss this part";

const search = [part.title, part.vehicleLabel, part.yearRange, part.oemNumber, part.category, statusLabel]
  .filter(Boolean).join(" ").toLowerCase();
---
<article class="card" data-state={part.state} data-safety-gated={String(safetyGated)} data-search={search}>
  {safetyGated && !art ? (
    <div class="card-safety">
      <span class="safety-head">{closed.toUpperCase()}</span>
      {testing
        ? <small>On the car since {testing.since}.<br />Still proving: {testing.proving}.</small>
        : <small>Still awaiting final testing:<br />vibration, UV exposure, rain function.</small>}
    </div>
  ) : (
    <div class="card-art">
      {measured && <span class="layer">{part.dimsConfirmed} DIMENSIONS</span>}
      {art
        ? <PhotoCarousel photos={art.photos} variant="card" label={`${part.title} photos`} note={art.note} renderLabel="CAD RENDER · NOT A TEST RESULT" />
        : <div class="placeholder art-ph"><span>NO VIEW YET</span></div>}
      <span class="tape" aria-hidden="true"></span>
    </div>
  )}

  <dl class="card-spec">
    <dt class="eyebrow">PART</dt><dd class="part-name">{part.title}</dd>
    <dt class="eyebrow">CAR</dt><dd>{application}</dd>
    {safetyGated
      ? <><dt class="eyebrow">FOR SALE</dt><dd>No, still testing</dd></>
      : oemPublishable
        ? <><dt class="eyebrow">OEM №</dt><dd>{part.oemNumber}</dd></>
        : <><dt class="eyebrow">OEM №</dt><dd>{oemIdentityLabel(part)}</dd></>}
    <dt class="eyebrow">STATUS</dt>
    <dd><Stamp state={part.state} label={statusLabel} safetyGated={safetyGated} /></dd>
  </dl>

  <div class="card-ladder"><EvidenceLadder state={part.state} safetyGated={safetyGated} closedLabel={closed} compact /></div>

  <a class="card-action" href={href}>{action}<span aria-hidden="true">→</span></a>
</article>

<style>
  .card { display: flex; flex-direction: column; border: 1px solid var(--paper); background: var(--ground); box-shadow: 4px 5px 0 color-mix(in srgb, var(--paper) 14%, transparent); }
  .card[hidden] { display: none; }
  .card-art { position: relative; min-height: 208px; overflow: hidden; border-bottom: 1px solid var(--rule); background: var(--ground-deep); }
  .art-ph { height: 208px; border: 0; }
  .layer { position: absolute; z-index: 2; top: 10px; right: 10px; padding: 4px 7px; background: var(--ground); color: var(--st-measured); font-size: var(--t-micro); font-weight: 600; letter-spacing: var(--t-micro-tr); text-transform: uppercase; }
  .tape { position: absolute; z-index: 3; top: -9px; left: 50%; width: 86px; height: 20px; background: rgba(211,177,109,.72); transform: translateX(-50%) rotate(-4deg); }
  .card-safety { height: 208px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 0 18px; border-bottom: 1px dashed var(--rule-2); text-align: center; }
  .card-safety { background: repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--signal) 18%, transparent) 14px 15px), var(--journal-charcoal); }
  .safety-head { font-size: var(--t-eyebrow); font-weight: 600; letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; }
  .safety-head { color: var(--acid); }
  .card-safety small { font-family: var(--font-text); font-size: var(--t-dense); line-height: 1.5; color: var(--steel); }
  .card-safety small { color: var(--inv-body); }
  .card-spec { display: grid; grid-template-columns: 76px 1fr; gap: 9px 12px; align-content: start; align-items: baseline; flex: 1; margin: 0; padding: 18px 18px 14px; }
  .card-spec dt { font-size: var(--t-micro); }
  .card-spec dd { margin: 0; color: var(--body); font-family: var(--font-text); font-size: var(--t-dense); line-height: 1.4; }
  .part-name { color: var(--paper) !important; font-family: var(--font-display) !important; font-size: var(--h-card) !important; font-weight: 700; line-height: 1.08 !important; text-transform: uppercase; }
  .card-ladder { padding: 0 18px 16px; }
  .card-action { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 48px; padding: 13px 18px; border-top: 1px solid var(--rule); color: var(--paper); font-size: var(--t-eyebrow); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .card-action:hover { background: var(--journal-board); color: var(--ink); }
  .card-action span { color: var(--signal); font-size: 17px; }
  .card-action:hover span { color: var(--acid); }
</style>
