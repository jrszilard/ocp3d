---
/**
 * Shared Bench Journal masthead.
 *
 * Each route opens like a usable investigation sheet: literal title, visible
 * field-file identity, and a compact reminder that every route returns to a
 * physical interface. It carries no speculative product or fitment claim.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  file?: string;
  signal?: string;
  compact?: boolean;
  unit?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  file = "OCP3D FIELD FILE",
  signal = "TRACE · MEASURE · RECORD",
  compact = false,
  unit = false,
} = Astro.props;
---
<header class:list={["service-heading", { "is-compact": compact, "has-unit": unit }]}>
  <div class="heading-copy">
    <p class="eyebrow heading-kicker">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lead heading-lede">{lede}</p>}
  </div>

  <aside class="case-note" aria-label="Field-file context">
    <div class="case-note-head"><span>PARTS INVESTIGATION</span><i aria-hidden="true"></i></div>
    <p class="case-file">{file}</p>
    <dl>
      <div><dt>START</dt><dd>PHYSICAL INTERFACE</dd></div>
      <div><dt>PATHS</dt><dd>RESTORE · IMPROVE</dd></div>
      <div><dt>ROUTE</dt><dd>{signal}</dd></div>
    </dl>
    <p class="case-rule">A lead is useful only when it returns to evidence.</p>
  </aside>
</header>

<style>
  .service-heading {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 30%); min-height: 266px;
    border: var(--bd-inner) solid var(--rule-2); background:
      repeating-linear-gradient(0deg, transparent 0 31px, rgba(56,78,72,.14) 31px 32px),
      var(--ground);
    overflow: hidden;
  }
  .heading-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 41px 43px; }
  .heading-kicker { color: var(--signal); margin-bottom: 15px; }
  h1 { max-width: 13ch; }
  .heading-lede { max-width: 62ch; margin-top: 17px; color: var(--body); }

  .case-note { align-self: stretch; position: relative; padding: 24px 24px 20px; border-left: 2px solid var(--paper); background: var(--journal-board); color: var(--ink); }
  .case-note::after { content: ""; position: absolute; right: -43px; bottom: -45px; width: 190px; height: 190px; border: 1px solid rgba(230,182,95,.58); border-radius: 50%; box-shadow: 0 0 0 22px rgba(230,182,95,.12), 0 0 0 44px rgba(230,182,95,.06); }
  .case-note-head { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--ion-light); font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .case-note-head i { width: 28px; border-top: 2px solid var(--acid); }
  .case-file { position: relative; z-index: 1; margin: 18px 0 15px; color: var(--ink); font-family: var(--font-display); font-size: 25px; line-height: .92; text-transform: uppercase; }
  dl { position: relative; z-index: 1; margin: 0; }
  dl > div { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid rgba(246,237,217,.24); }
  dt, dd { margin: 0; font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: .08em; }
  dt { color: var(--acid); } dd { max-width: 62%; color: var(--inv-body); text-align: right; text-transform: uppercase; }
  .case-rule { position: relative; z-index: 1; max-width: 27ch; margin-top: 17px; padding-top: 11px; border-top: 1px solid rgba(246,237,217,.24); color: var(--inv-label); font-family: Georgia, serif; font-size: 14px; font-style: italic; line-height: 1.35; }

  .is-compact { min-height: 210px; }.is-compact .heading-copy { padding-block: 31px; }.is-compact .case-file { font-size: 20px; margin-block: 13px; }.is-compact .case-rule { display: none; }

  @media (max-width: 720px) {
    .service-heading { grid-template-columns: 1fr; }
    .heading-copy { padding: 34px 24px; }
    .case-note { border-left: 0; border-top: 2px solid var(--paper); padding: 22px 24px; }
  }
</style>
