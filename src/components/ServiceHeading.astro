---
/**
 * OCP3D High Desert Retrofit heading.
 *
 * A literal page title paired with a useful station-status surface. It is not
 * a hero illustration: inherited bench/fixture cues and newer scan/record
 * cues are carried as small functional fragments instead.
 */
import BenchUnit from "./BenchUnit.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  file?: string;
  signal?: string;
  compact?: boolean;
  unit?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  file = "OCP3D FIELD FILE",
  signal = "MEASURE · MODEL · PRINT",
  compact = false,
  unit = false,
} = Astro.props;
---
<header class:list={["service-heading", { "is-compact": compact, "has-unit": unit }]}>
  <div class="heading-copy">
    <p class="eyebrow heading-kicker">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lead heading-lede">{lede}</p>}
  </div>

  <aside class="station-status" aria-label="Station status">
    <p class="status-kicker">STATION CONDITION / 07</p>
    <p class="status-title">RETROFIT<br />RECORD READY</p>
    <dl>
      <div><dt>OLD LAYER</dt><dd>fixture / bench</dd></div>
      <div><dt>NEW LAYER</dt><dd>scan / record</dd></div>
      <div><dt>FILE</dt><dd>{file}</dd></div>
    </dl>
    {unit && (
      <div class="unit-row">
        <BenchUnit size={54} />
        <span><b>BENCH UNIT / DOCKED</b><em>PHYSICAL SCAN ASSIST</em></span>
      </div>
    )}
    <p class="status-signal">{signal}</p>
  </aside>
</header>

<style>
  .service-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(264px, 31%);
    min-height: 238px;
    border: var(--bd-inner) solid var(--rule-2);
    background:
      repeating-linear-gradient(-9deg, transparent 0 5px, rgba(41,37,44,.04) 5px 6px),
      linear-gradient(120deg, var(--ground) 0 57%, var(--ground-deep) 57% 72%, color-mix(in srgb, var(--signal) 46%, var(--ground-deep)) 72%);
    overflow: hidden;
  }
  .heading-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 36px 40px;
  }
  .heading-kicker { color: var(--signal); margin-bottom: 14px; }
  h1 { max-width: 13ch; }
  .heading-lede { max-width: 62ch; margin-top: 17px; color: var(--body); }

  .station-status {
    align-self: center;
    justify-self: end;
    width: min(100%, 285px);
    margin: 28px;
    padding: 16px 17px;
    border: var(--bd-inner) solid color-mix(in srgb, var(--desert-dusk) 76%, var(--signal));
    border-top: 4px solid var(--ion-light);
    background: color-mix(in srgb, var(--desert-night) 95%, #000);
    color: var(--inv-body);
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--signal) 68%, transparent);
  }
  .status-kicker { color: var(--ion-light); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .status-title { margin: 9px 0 13px; color: var(--ink); font-family: var(--font-display); font-size: 27px; line-height: .92; text-transform: uppercase; }
  dl { margin: 0; }
  dl > div { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-top: 1px solid color-mix(in srgb, var(--inv-label) 35%, transparent); }
  dt, dd { margin: 0; font-size: 8px; letter-spacing: .08em; }
  dt { color: var(--acid); }
  dd { max-width: 58%; color: var(--inv-body); text-align: right; text-transform: uppercase; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .unit-row { display: flex; align-items: center; gap: 10px; padding-top: 10px; margin-top: 8px; border-top: 1px solid color-mix(in srgb, var(--inv-label) 35%, transparent); }
  .unit-row span { display: grid; gap: 2px; font-size: 7px; line-height: 1.4; letter-spacing: .06em; }
  .unit-row b { color: var(--acid); font-weight: 400; }
  .unit-row em { color: var(--signal); font-style: normal; }
  .status-signal { margin: 11px 0 0; padding-top: 9px; border-top: 1px solid color-mix(in srgb, var(--inv-label) 35%, transparent); color: var(--inv-label); font-size: 7px; line-height: 1.45; letter-spacing: .08em; text-transform: uppercase; }

  .is-compact { min-height: 184px; }
  .is-compact .heading-copy { padding-block: 27px; }
  .is-compact .station-status { margin-block: 18px; }
  .is-compact .status-title { font-size: 22px; }

  @media (max-width: 720px) {
    .service-heading { grid-template-columns: 1fr; }
    .heading-copy { padding: 30px 24px; }
    .station-status { justify-self: stretch; width: auto; margin: 0 24px 24px; }
  }
</style>
