---
import type { Dim } from "../lib/catalog";
interface Props { dims: Dim[]; confirmed: number; total: number }
const { dims, confirmed, total } = Astro.props;
---
<div class="table-holder">
  <table class="dims">
    <caption>Critical dimensions — confirmed {confirmed} of {total} (the field file keeps every confidence level visible)</caption>
    <thead><tr><th>Dimension</th><th>mm</th><th>Confidence</th></tr></thead>
    <tbody>
      {dims.map((d) => (
        <tr>
          <td>{d.name}</td>
          <td>{d.mm ?? "—"}</td>
          <td class={d.confidence === "confirmed" ? "conf" : "est"}>{d.confidence.toUpperCase()}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-holder { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--t-dense); }
  caption { padding-bottom: 12px; color: var(--steel); font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-align: left; text-transform: uppercase; }
  th { padding: 6px 14px 8px 0; border-bottom: 1px solid var(--rule-2); color: var(--steel); font-size: var(--t-micro); font-weight: 400; letter-spacing: var(--t-micro-tr); text-align: left; text-transform: uppercase; }
  td { padding: 8px 14px 8px 0; border-bottom: 1px solid var(--rule-3); color: var(--body); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .conf { color: var(--signal); font-weight: 600; }.est { color: var(--steel); }
</style>
