---
/**
 * OCP3D Bench Journal shell.
 *
 * A warm field record inside a dark investigation surround. The roadbook cues
 * describe how a part problem is traced back to physical evidence; they are
 * not a claim of racing, travel, safety, or performance work.
 */
import "../styles/global.css";
import Lockup from "../components/Lockup.astro";

interface Props { title: string; description?: string; sheet?: string }
const {
  title,
  description = "OCP3D investigates old-car problems from a physical interface, then keeps the useful evidence on record.",
  sheet = "PARTS INVESTIGATION · 01",
} = Astro.props;

const nav = [
  { href: "/registry/", label: "Field files" },
  { href: "/method/",   label: "How I investigate" },
  { href: "/charter/",  label: "Mission" },
];
const canonical = `https://ocp3d.com${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e2428" />
    <meta property="og:site_name" content="OCP3D — Old Car Problems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Self-hosted: a privacy promise is false if typography phones home. -->
    <link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-narrow-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="sheet-outer">
      <div class="sheet">
        <header class="journal-header">
          <a class="lockup-link" href="/" aria-label="OCP3D — Old Car Problems — home">
            <Lockup variant="landscape" />
          </a>
          <nav class="nav" aria-label="Primary">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
            <a class="cta" href="/request/">OPEN A PART<br />DISCUSSION</a>
          </nav>
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="case-footer">
          <div><span class="micro">JOURNAL</span><span class="val">PARTS INVESTIGATION</span></div>
          <div><span class="micro">STARTING POINT</span><span class="val">1983 CELICA SUPRA</span></div>
          <div><span class="micro">PART PATHS</span><span class="val">RESTORE · IMPROVE</span></div>
          <div><span class="micro">FIELD FILE</span><span class="val">{sheet}</span></div>
          <div class="legal">
            © 2026 OCP3D · Old Car Problems · Pre-2000, unbranded, non-safety-critical parts.
            No trackers, analytics, ad pixels, or third-party scripts. OEM part numbers appear for
            identification only; OCP3D is not affiliated with any manufacturer.
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .journal-header {
    display: grid; grid-template-columns: 1fr auto; align-items: stretch; min-height: 72px;
    border-bottom: 2px solid var(--paper); background: var(--ground);
  }
  .lockup-link { display: flex; align-items: center; padding: 14px 24px; text-decoration: none; }
  .nav { display: flex; align-items: stretch; gap: 20px; }
  .nav > a:not(.cta) {
    display: flex; align-items: center; color: var(--steel); font-family: var(--font-mono);
    font-size: var(--t-nav); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap;
  }
  .nav > a:not(.cta):hover { color: var(--signal); }
  .cta {
    display: grid; place-items: center; min-width: 168px; padding: 0 16px; background: var(--signal);
    color: var(--ink) !important; border-left: 1px solid var(--paper); font-family: var(--font-mono);
    font-size: var(--t-button); font-weight: 600; line-height: 1.35; letter-spacing: var(--t-button-tr);
    text-align: center; text-transform: uppercase;
  }
  .cta:hover { background: var(--ion); }

  .case-footer { display: grid; grid-template-columns: .9fr 1.1fr 1fr 1fr 2.15fr; border-top: 2px solid var(--paper); background: var(--journal-charcoal); }
  .case-footer > div { display: flex; flex-direction: column; gap: 5px; padding: 15px 16px; border-left: 1px solid rgba(246,237,217,.22); }
  .case-footer > div:first-child { border-left: 0; }
  .micro { color: var(--ion-light); font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; }
  .val { color: var(--ink); font-family: var(--font-mono); font-size: var(--t-eyebrow); line-height: 1.5; }
  .legal { justify-content: center; color: var(--inv-label); font-family: var(--font-mono); font-size: var(--t-micro); line-height: 1.65; }

  @media (max-width: 980px) { .nav { gap: 14px; } .nav > a:not(.cta) { font-size: var(--t-micro); } }
  @media (max-width: 760px) {
    .journal-header { grid-template-columns: 1fr; }
    .lockup-link { padding: 16px; }
    .nav { flex-wrap: wrap; gap: 13px; padding: 0 16px 16px; }
    .nav > a:not(.cta) { min-height: 28px; }
    .cta { min-width: 145px; min-height: 43px; margin-left: auto; }
    .case-footer { grid-template-columns: 1fr 1fr; }
    .case-footer > div:nth-child(odd) { border-left: 0; }
    .legal { grid-column: 1 / -1; border-top: 1px solid rgba(246,237,217,.22); }
  }
</style>
