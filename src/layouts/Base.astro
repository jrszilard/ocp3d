---
/**
 * OCP3D site shell.
 *
 * A warm paper sheet inside a dark workshop surround: stamp-mark lockup, five
 * plain-language destinations and one enquiry action. Navigation uses the
 * site's small, fixed vocabulary (Custom design, Parts & projects, Build logs,
 * Materials, About, Start an enquiry); coined labels stay out of the chrome.
 */
import "../styles/global.css";
import Lockup from "../components/Lockup.astro";
import { car } from "../data/car.mjs";

interface Props {
  title: string;
  description?: string;
  sheet?: string;
  noindex?: boolean;
  // Link previews (Open Graph): a real photo from the site, never a render presented as proof.
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  // schema.org JSON-LD, inline data only (no script loads).
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = "Parts, custom design and prototyping for old-car problems across makes. OCP3D is an independent workshop in New Hampshire’s Lakes Region. Start with the car and the problem.",
  sheet = "OCP3D",
  noindex = false,
  image = car.photos[0].src,
  imageAlt = car.photos[0].alt,
  type = "website",
  jsonLd,
} = Astro.props;

const nav = [
  { href: "/custom/", label: "Custom design" },
  { href: "/registry/", label: "Parts & projects" },
  { href: "/journal/", label: "Build logs" },
  { href: "/materials/", label: "Materials" },
  { href: "/charter/", label: "About" },
];
const canonical = `https://ocp3d.com${Astro.url.pathname}`;
const imageUrl = new URL(image, "https://ocp3d.com").href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e2428" />
    <meta property="og:site_name" content="OCP3D — Old Car Problems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Self-hosted: a privacy promise is false if typography phones home. -->
    <link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-narrow-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="sheet-outer">
      <div class="sheet">
        <header class="journal-header">
          <a class="lockup-link" href="/" aria-label="OCP3D — Old Car Problems — home">
            <Lockup variant="landscape" />
          </a>
          <nav class="nav" aria-label="Primary">
            {nav.map((n) => <a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
          </nav>
          <a class="cta" href="/request/">START AN<br />ENQUIRY</a>
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="case-footer">
          <div><span class="micro">THE WORKSHOP</span><span class="val">LAKES REGION, NH</span></div>
          <div><span class="micro">OLD CARS</span><span class="val">ACROSS MAKES &amp; MODELS</span></div>
          <div><span class="micro">A CLOSER LOOK</span><a class="val" href="/method/">HOW A PART IS DEVELOPED ↗</a></div>
          <div><span class="micro">THIS PAGE</span><span class="val">{sheet}</span></div>
          <div class="legal">
            © 2026 OCP3D · Old Car Problems · Pre-2000, unbranded, non-safety-critical parts.
            No trackers, analytics, ad pixels, or third-party scripts. OEM part numbers appear for
            identification only; OCP3D is not affiliated with any manufacturer.
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .skip-link { position: absolute; top: 8px; left: 24px; z-index: 10; transform: translateY(-200%); background: var(--ground); border: 2px solid var(--paper); padding: 10px 16px; }
  .skip-link:focus { transform: translateY(0); }
  .journal-header {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: stretch; min-height: 72px;
    border-bottom: 2px solid var(--paper); background: var(--ground);
  }
  .lockup-link { display: flex; align-items: center; padding: 14px 24px; text-decoration: none; }
  .nav { display: flex; align-items: stretch; gap: 20px; padding-right: 20px; }
  .nav > a:not(.cta) {
    display: flex; align-items: center; color: var(--steel); font-family: var(--font-mono);
    font-size: var(--t-nav); letter-spacing: .05em; text-transform: uppercase; white-space: nowrap;
  }
  .nav > a:not(.cta):hover { color: var(--paper); }
  .nav > a[aria-current="page"] { color: var(--paper); text-decoration: underline; text-underline-offset: 6px; }
  .cta {
    display: grid; place-items: center; min-width: 168px; padding: 0 16px; background: var(--signal);
    color: var(--ink) !important; border-left: 1px solid var(--paper); font-family: var(--font-mono);
    font-size: var(--t-button); font-weight: 600; line-height: 1.35; letter-spacing: var(--t-button-tr);
    text-align: center; text-transform: uppercase;
  }
  .cta:hover { background: var(--ion); }

  .case-footer { display: grid; grid-template-columns: .9fr 1.1fr 1fr 1fr 2.15fr; border-top: 2px solid var(--paper); background: var(--journal-charcoal); }
  .case-footer > div { display: flex; flex-direction: column; gap: 5px; padding: 15px 16px; border-left: 1px solid rgba(246,237,217,.22); }
  .case-footer > div:first-child { border-left: 0; }
  .micro { color: var(--ion-light); font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; }
  .val { color: var(--ink); font-family: var(--font-mono); font-size: var(--t-eyebrow); line-height: 1.5; }
  .legal { justify-content: center; color: var(--inv-label); font-family: var(--font-text); font-size: 13px; line-height: 1.55; }

  @media (max-width: 1180px) { .nav { gap: 14px; padding-right: 14px; } .nav > a:not(.cta) { font-size: 11px; letter-spacing: .03em; } .cta { min-width: 130px; } }
  @media (max-width: 900px) {
    .journal-header { grid-template-columns: minmax(0, 1fr) auto; }
    .lockup-link { padding: 16px; }
    .nav { grid-column: 1 / -1; grid-row: 2; flex-wrap: wrap; gap: 0 24px; padding: 0 16px 10px; }
    .nav > a:not(.cta) { min-height: 44px; font-size: var(--t-nav); }
    .cta { grid-column: 2; grid-row: 1; min-width: 125px; min-height: 44px; margin: 12px 16px 12px 0; border: 1px solid var(--paper); }
  }
  @media (max-width: 540px) {
    .lockup-link { padding: 14px 12px; }
    .nav { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 0 14px; padding: 0 12px 8px; }
    .nav > a:not(.cta) { font-size: var(--t-micro); white-space: normal; }
    .cta { min-width: 94px; padding: 8px; margin-right: 12px; }
  }
  @media (max-width: 760px) {
    .case-footer { grid-template-columns: 1fr 1fr; }
    .case-footer > div:nth-child(odd) { border-left: 0; }
    .legal { grid-column: 1 / -1; border-top: 1px solid rgba(246,237,217,.22); }
  }
</style>
