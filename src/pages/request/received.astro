---
import Base from "../../layouts/Base.astro";
import ServiceHeading from "../../components/ServiceHeading.astro";
---
<Base title="Enquiry Received — OCP3D" sheet="ENQUIRY RECEIVED">
  <section class="receipt-page">
    <div class="wrap receipt-wrap">
      <ServiceHeading
        eyebrow="OCP3D · ENQUIRY RECEIVED"
        title="Thanks. It’s in."
        lede="The next step is a person, not a robot: I’ll read what you sent and write back about the honest way forward."
        file="WHAT HAPPENS NEXT"
        facts={[["NEXT", "A PERSONAL REPLY"], ["ORDERED", "NOTHING"], ["PAID", "NOTHING"]]}
        compact
      />
      <div class="done">
        <div class="done-stamp">Received</div>
        <p class="done-case">Your reference: <b id="case-id">on file</b></p>
        <p id="what">I’ll write from the workshop within a few days. Replies to that email reach me directly, and photos are welcome.</p>
        <p class="done-alt">Nothing after a week? Email <a href="mailto:requests@ocp3d.com">requests@ocp3d.com</a> and include your reference.</p>
        <p><a class="btn btn--secondary" href="/registry/">Back to parts &amp; projects</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  const q = new URLSearchParams(location.search);
  const caseId = q.get("case");
  if (caseId) document.getElementById("case-id").textContent = caseId;
  if (q.get("type") === "membership") {
    document.getElementById("what").textContent =
      "You’re on the OCP3D email updates list. I only write when a part moves forward — never for noise.";
    document.querySelector(".done-stamp").textContent = "You’re on the list";
  }
</script>

<style>
  .receipt-page { min-height: 56vh; background: linear-gradient(180deg, color-mix(in srgb, var(--ground-deep) 30%, transparent), transparent 45%); }
  .receipt-wrap { display: grid; gap: 18px; }
  .done { width: min(100%, 760px); margin-inline: auto; background: var(--panel); color: var(--paper); border: var(--bd-inner) solid var(--rule-2); padding: 32px; }
  .done-stamp { display: inline-block; font-size: var(--t-dense); font-weight: 700; letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; color: var(--signal); border: 1px solid var(--signal); padding: 6px 10px; transform: rotate(-2deg); margin-bottom: 14px; }
  .done-case { font-size: .95rem; color: var(--paper); }
  .done p { color: var(--steel); }
  .done-alt { font-size: var(--t-eyebrow); }
  .done-alt a { color: var(--ion); }
  .done .btn { margin-top: 7px; }
  @media (max-width: 600px) { .done { padding: 22px; } }
</style>
