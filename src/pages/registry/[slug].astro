---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import ServiceHeading from "../../components/ServiceHeading.astro";
import Stamp from "../../components/Stamp.astro";
import SpecTable from "../../components/SpecTable.astro";
import { allParts, fitmentLabel, oemIdentityLabel } from "../../lib/catalog";

export function getStaticPaths() {
  return allParts().map((part) => ({ params: { slug: part.slug }, props: { part } }));
}
const { part } = Astro.props;
const orderable = part.state === "measured" || part.state === "fitted";
const oemLabel = oemIdentityLabel(part);
const identityDisputed = part.oemIdentityStatus === "disputed";
const fitmentUnconfirmed = part.fitmentStatus !== "confirmed";
const fitmentDisputed = part.fitmentStatus === "disputed";
const vehicleFitment = fitmentLabel(part);
const identityTitle = part.oemNumber
  ? `OEM ${part.oemNumber} reproduction`
  : identityDisputed
    ? "OEM identity under investigation"
    : "OEM identity pending";

// Neutral-resin render, once the part is modeled (scripts/render-part.py).
const imgSrc = `/images/parts/${part.slug}.jpg`;
const hasImage = fs.existsSync(path.join(process.cwd(), "public", "images", "parts", `${part.slug}.jpg`));
---
<Base title={`${part.title} — ${identityTitle} — OCP3D`}
      description={part.description.slice(0, 155)}
      sheet={`FIELD FILE · ${part.slug.toUpperCase()}`}>
  <section class="part-page">
    <div class="wrap part-wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/registry/">Parts archive</a><span>/</span><span>{part.title}</span></nav>

      <ServiceHeading
        eyebrow={`${oemLabel} · ${vehicleFitment}`}
        title={part.title}
        lede="A working record, not a sales gloss. The geometry, material, and real-car evidence each earn their own line."
        file={`FIELD FILE · ${part.slug.replaceAll("-", " ").toUpperCase()}`}
        signal={part.stateLabel}
      />

      <div class="part-scope">
        {hasImage ? (
          <figure class="media">
            <img src={imgSrc} alt={`${part.title} — reproduction render, neutral resin`}
                 width="1024" height="768" />
            <figcaption>
              <span>REPRODUCTION VIEW</span>
              <span>NEUTRAL RESIN · EVIDENCE, NOT PROMISE</span>
            </figcaption>
          </figure>
        ) : (
          <div class="media media--pending placeholder">
            <span>CASE VIEW PENDING</span>
            <small>No physical view is claimed until there is a real object to show.</small>
          </div>
        )}

        <div class="case-summary">
          <div class="case-status">
            <div>
              <p class="eyebrow">CURRENT EVIDENCE STATUS</p>
              <p class="status-caption">The label below is literal. It is not a fit, strength, or availability claim beyond the record.</p>
            </div>
            <Stamp state={part.state} label={part.stateLabel} />
          </div>
          <p class="brief-copy">{part.description}</p>
          {identityDisputed && (
            <p class="identity-notice" role="note">
              <b>OEM identity under investigation.</b> The measured object and this permanent case
              file stay on record, but an earlier catalog assignment did not match the demonstrated
              part architecture. The number stays unpublished until mounting-location and donor
              evidence agree.
            </p>
          )}
          {fitmentUnconfirmed && (
            <p class="identity-notice" role="note">
              {fitmentDisputed ? (
                <>
                  <b>Vehicle/trim fitment under investigation.</b> This OEM handle family is real,
                  but the earlier Celica Supra application combined a broad catalog row with an MA61
                  diagram that contains separate manual- and power-window branches. Toyota’s 1982–1984
                  U.S. Celica Supra brochures list power windows on both Supra trims. We will not
                  call this a Supra part unless a market- and trim-specific manual-window build record
                  proves it.
                </>
              ) : (
                <><b>Vehicle/trim fitment is not yet confirmed.</b> Model, market, trim, and equipment evidence must agree before this case file makes a vehicle claim.</>
              )}
            </p>
          )}
          {part.supersededTo && (
            <p class="paper-trail">
              <b>The paper trail:</b> superseded to {part.supersededTo}
              {part.colors.length > 1 &&
                ` — originally available in ${part.colors.join(", ")}; the replacement came only in Black. Ours can come in your color.`}
            </p>
          )}
        </div>
      </div>

      <section class="record-panel" aria-label={`${part.title} record`}>
        <div class="record-head">
          <div>
            <p class="eyebrow">MEASUREMENT BAY</p>
            <h2>Dimensions on record.</h2>
          </div>
          <p class="dense">Published free. CAD stays in the workshop. Every estimate remains visibly an estimate.</p>
        </div>
        {part.dims.length > 0 && (
          <SpecTable dims={part.dims} confirmed={part.dimsConfirmed} total={part.dimsTotal} />
        )}

        <div class="actions">
          <div class="commission">
            <div class="blk-label">NEXT ACTION</div>
            {orderable ? (
              <div class="row">
                <a class="btn btn--primary" href="/request/">Order this part</a>
                <span class="cap">Made to order, one at a time · <b>fits or we remake it free</b> · ships with its own fit-report card</span>
              </div>
            ) : part.state === "development" ? (
              <div class="row">
                <a class="btn btn--primary" href="/request/">Reserve one</a>
                <span class="cap">In development — reserving bumps it up the queue and locks your place</span>
              </div>
            ) : (
              <div class="vote-block">
                <div class="demand-line" data-demand-line data-part={part.slug} hidden></div>
                <form class="vote-row" data-vote-form data-part={part.slug} method="post" action="/api/request">
                  <input type="hidden" name="type" value="vote" />
                  <input type="hidden" name="part_slug" value={part.slug} />
                  <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
                  <input type="email" name="email" required placeholder="you@garage.example" aria-label="Email address" />
                  <button class="btn btn--primary" type="submit">Vote for this part</button>
                </form>
                <span class="cap vote-done" data-vote-done hidden></span>
                <span class="cap">Not started yet — one vote per person, votes move it up the queue.
                  Or <a href={`/request/?part=${encodeURIComponent(part.title)}&part_slug=${part.slug}`}>open a full case file</a> — sponsoring starts it now.</span>
              </div>
            )}
          </div>
          <aside class="assist">
            <div class="blk-label">HELP OUT · OPTIONAL</div>
            <p>Own an original, or fitted one of ours? A quick report makes the record stronger.</p>
            <div class="assist-links">
              <a href="/request/">Share a fit report</a>
              <a href="/#register">Get notified about this part</a>
            </div>
          </aside>
        </div>
      </section>

      {part.fitReports.length > 0 && (
        <section class="testimony">
          <p class="eyebrow">REAL-CAR RECORD</p>
          <h2>Fit reports</h2>
          {part.fitReports.map((r) => (
            <div class="report">
              FIT REPORT · {r.vehicle} · {r.material} · <b>{r.result.toUpperCase()}</b>
            </div>
          ))}
        </section>
      )}

      <p class="record-line">
        OCP3D field file ·
        {part.oemNumber ? `Case № ${part.oemNumber}` : "Case pending identification"}
      </p>
    </div>
  </section>
</Base>

<script>
  const line = document.querySelector("[data-demand-line]") as HTMLElement;
  const voteForm = document.querySelector("[data-vote-form]") as HTMLFormElement;
  const voteDone = document.querySelector("[data-vote-done]") as HTMLElement;

  function renderDemand(d: { votes: number; requests: number; total: number }) {
    line.innerHTML = d.total === 0
      ? "Nothing on the want-list yet — your vote starts the queue."
      : `On the want-list: <b>${d.votes}</b> vote${d.votes === 1 ? "" : "s"} · <b>${d.requests}</b> case file${d.requests === 1 ? "" : "s"}`;
    line.hidden = false;
  }

  if (line && voteForm) {
    const slug = line.dataset.part;
    fetch(`/api/demand?part=${slug}`)
      .then((r) => r.json())
      .then((d) => { if (d.configured !== false) renderDemand(d); })
      .catch(() => {});

    voteForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = voteForm.querySelector("button") as HTMLButtonElement;
      btn.disabled = true;
      try {
        const res = await fetch(voteForm.action, {
          method: "POST",
          body: new FormData(voteForm),
          headers: { accept: "application/json" },
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          voteForm.hidden = true;
          voteDone.textContent = data.duplicate
            ? "That email is already on the want-list for this part."
            : "Vote counted — it's on the ledger.";
          voteDone.hidden = false;
          if (!data.duplicate && !line.hidden) {
            fetch(`/api/demand?part=${slug}&fresh=${Date.now()}`).then((r) => r.json()).then(renderDemand).catch(() => {});
          }
        } else if (data.unconfigured) {
          window.location.href = `/request/?part=${slug}`;
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .part-page { background: linear-gradient(180deg, color-mix(in srgb, var(--ground-deep) 28%, transparent), transparent 32%); }
  .part-wrap { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-size: var(--t-eyebrow); color: var(--steel); text-transform: uppercase; letter-spacing: .1em; }
  .crumbs a { color: var(--ion); }

  .part-scope { display: grid; grid-template-columns: minmax(0, .96fr) minmax(320px, 1.04fr); border: var(--bd-inner) solid var(--rule); background: var(--panel); }
  .media { display: flex; flex-direction: column; margin: 0; min-width: 0; border-right: var(--bd-inner) solid var(--rule); background: var(--ground-deep); }
  .media img { width: 100%; height: auto; min-height: 0; aspect-ratio: 4 / 3; object-fit: cover; }
  .media figcaption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-top: var(--bd-inner) solid var(--rule); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); color: var(--steel); }
  .media--pending { min-height: 360px; }
  .case-summary { padding: 28px 30px; }
  .case-status { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding-bottom: 18px; border-bottom: var(--bd-inner) solid var(--rule); }
  .status-caption { max-width: 38ch; margin-top: 6px; font-size: var(--t-dense); line-height: var(--t-dense-lh); color: var(--steel); }
  .brief-copy { margin: 20px 0 16px; color: var(--body); }
  .paper-trail { color: var(--steel); font-size: var(--t-dense); }
  .identity-notice { padding: 13px 15px; margin: 14px 0; border-left: 3px solid var(--ion); background: color-mix(in srgb, var(--ion) 9%, transparent); color: var(--steel); font-size: var(--t-dense); line-height: var(--t-dense-lh); }
  .identity-notice b { color: var(--paper); }

  .record-panel { border: var(--bd-inner) solid var(--rule-2); background: var(--panel); }
  .record-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 24px 30px 18px; border-bottom: var(--bd-inner) solid var(--rule); }
  .record-head h2, .testimony h2 { margin-top: 7px; font-size: 28px; }
  .record-head .dense { max-width: 43ch; color: var(--steel); }
  .record-panel :global(.table-holder) { padding: 20px 30px 0; }

  .actions { display: grid; grid-template-columns: 1.2fr .9fr; margin-top: 22px; border-top: var(--bd-inner) solid var(--rule); }
  .commission { padding: 22px 30px; background: var(--paper); color: var(--ink); border-right: var(--bd-inner) solid var(--rule); }
  .assist { padding: 22px 30px; color: var(--paper); }
  .blk-label { font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; margin-bottom: 12px; }
  .commission .blk-label { color: var(--inv-gold); }
  .assist .blk-label { color: var(--ion); }
  .row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .cap { font-size: var(--t-eyebrow); color: var(--inv-body); max-width: 40ch; }
  .cap b { color: var(--ink); }
  .assist p { margin: 0 0 14px; color: var(--steel); font-size: var(--t-dense); }
  .assist-links { display: flex; gap: 14px; flex-wrap: wrap; }
  .assist a { font-size: var(--t-eyebrow); color: var(--ion); }
  .assist a:hover { color: var(--signal); }
  .vote-block { display: grid; gap: 10px; }
  .vote-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .vote-row .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .vote-row input { flex: 1; min-width: 200px; font: inherit; font-size: .85rem; padding: 11px 12px; background: var(--ground-deep); border: var(--bd-inner) solid var(--rule); color: var(--paper); }
  .demand-line { font-size: var(--t-eyebrow); letter-spacing: .04em; color: var(--inv-body); }
  .demand-line b, .vote-done { color: var(--inv-gold); font-weight: 700; }
  .vote-block .cap a { color: var(--inv-gold); text-decoration: underline; text-underline-offset: 3px; }

  .testimony { padding: 24px 30px; border: var(--bd-inner) solid var(--rule); background: var(--ground-deep); }
  .report { margin-top: 12px; border-left: 3px solid var(--signal); padding: 10px 14px; color: var(--steel); font-size: var(--t-dense); }
  .report b { color: var(--paper); }
  .record-line { padding-top: 14px; border-top: var(--bd-inner) solid var(--rule); color: var(--steel); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; }

  @media (max-width: 820px) {
    .part-scope, .actions { grid-template-columns: 1fr; }
    .media { border-right: 0; border-bottom: var(--bd-inner) solid var(--rule); }
    .commission { border-right: 0; border-bottom: var(--bd-inner) solid var(--rule); }
  }
  @media (max-width: 600px) {
    .case-summary, .record-head, .record-panel :global(.table-holder), .commission, .assist, .testimony { padding-inline: 20px; }
    .record-head { align-items: flex-start; flex-direction: column; gap: 10px; }
    .media--pending { min-height: 260px; }
    .case-status { flex-direction: column; }
  }
</style>
