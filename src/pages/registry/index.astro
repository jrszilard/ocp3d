---
import Base from "../../layouts/Base.astro";
import RegisterCard from "../../components/RegisterCard.astro";
import ServiceHeading from "../../components/ServiceHeading.astro";
import LadderKey from "../../components/LadderKey.astro";
import { listedParts } from "../../lib/catalog";
// Only parts with work behind them are listed; requested records with no work are not.
const parts = listedParts();
const hasFitRecord = parts.some((part) => part.state === "fitted" && !part.safetyGated);
---
<Base title="Parts & Projects — OCP3D"
      description="Explore existing OCP3D designs and their real development status. The collection began with the founder’s Supra; custom enquiries are welcome across eligible old-car makes."
      sheet={`PARTS & PROJECTS · ${parts.length}`}>
  <section class="archive-page">
    <div class="wrap archive-wrap">
      <ServiceHeading
        eyebrow="EXISTING DESIGNS / THEIR ACTUAL STATUS"
        title="Parts & projects."
        lede="What’s on the bench, and where each part stands."
        file={`${parts.length} PROJECT RECORDS`}
        audience="owner"
      />

      <aside class="collection-notice"><div><p class="eyebrow">LOOKING FOR A PART TO BUY?</p><h2>{hasFitRecord ? "Check the record. Then discuss your car." : "In development. Not a ready-to-buy range."}</h2><p>{hasFitRecord ? "Only parts with a real-car fit record can be discussed as made to order, after a check of your car." : "Development and research records, not stock."}</p></div><a href="/custom/">Have a different problem?<br />Explore custom design ↗</a></aside>

      <div class="archive-tools">
        <div class="tools">
          <label class="search-field" for="q">
            <span class="eyebrow">SEARCH PARTS &amp; PROJECTS</span>
            <input id="q" type="search" enterkeyhint="search"
                   placeholder="Part name, OEM №, keyword…"
                   aria-label="Search parts and projects" autocomplete="off" spellcheck="false" />
          </label>
          <div class="filters" role="group" aria-label="Filter by state">
            <button type="button" class="chip on" data-state="" aria-pressed="true">All</button>
            <button type="button" class="chip" data-state="fitted">Fitted on a real car</button>
            <button type="button" class="chip" data-state="measured">Measured</button>
            <button type="button" class="chip" data-state="development">In development</button>
            <button type="button" class="chip" data-state="safety">In testing</button>
          </div>
        </div>
        <p class="eyebrow count" id="count" aria-live="polite"></p>
      </div>

      <div class="cards" id="grid">
        {parts.map((p) => <RegisterCard part={p} />)}
        <LadderKey />
      </div>


      <div class="empty" id="empty" hidden>
        <p class="eyebrow eyebrow--amber">NO MATCH HERE YET</p>
        <p class="dense">Not listed? Tell me the car and the problem.</p>
        <a class="btn btn--primary" id="empty-cta" href="/request/">Discuss this part →</a>
        <button class="reset-filters" id="reset-filters" type="button">Clear search &amp; filters</button>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById("q") as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
  const cards = [...document.querySelectorAll<HTMLElement>("#grid .card")];
  const count = document.getElementById("count")!;
  const empty = document.getElementById("empty")!;
  const emptyCta = document.getElementById("empty-cta") as HTMLAnchorElement;
  let state = "";

  function apply(updateUrl = true) {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? "";
      const okState = !state || (state === "safety"
        ? card.dataset.safetyGated === "true"
        : card.dataset.state === state);
      const okText = terms.every((t) => hay.includes(t));
      const show = okState && okText;
      card.hidden = !show;
      if (show) shown++;
    }
    count.textContent = `SHOWING ${shown} OF ${cards.length}`;
    empty.hidden = shown !== 0;
    emptyCta.href = q ? `/request/?part=${encodeURIComponent(input.value.trim())}` : "/request/";
    if (updateUrl) {
      const url = new URL(location.href);
      if (q) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    }
  }

  input.addEventListener("input", () => apply());
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      chips.forEach((c) => { c.classList.toggle("on", c === chip); c.setAttribute("aria-pressed", String(c === chip)); });
      state = chip.dataset.state ?? "";
      apply(false);
    }),
  );
  chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.state === state)));
  document.getElementById("reset-filters")!.addEventListener("click", () => {
    input.value = "";
    state = "";
    chips.forEach((chip) => { chip.classList.toggle("on", chip.dataset.state === ""); chip.setAttribute("aria-pressed", String(chip.dataset.state === "")); });
    apply();
    input.focus();
  });
  const initial = new URL(location.href).searchParams.get("q");
  if (initial) input.value = initial;
  apply(false);
</script>

<style>
  .archive-page { background: repeating-linear-gradient(0deg, transparent 0 31px, rgba(65,82,76,.08) 31px 32px), var(--ground); }
  .archive-wrap { display: grid; gap: 18px; }
  .collection-notice { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 22px; padding: 25px; border-left: 4px solid var(--ion); background: var(--ground-deep); }
  .collection-notice > div { flex: 1 1 360px; }
  .collection-notice h2 { margin: 10px 0 13px; font-size: 27px; line-height: 1.1; }
  .collection-notice p:not(.eyebrow) { max-width: 74ch; color: var(--body); font-size: var(--t-dense); line-height: var(--t-dense-lh); }
  .collection-notice a { color: var(--ion); font-family: var(--font-text); font-size: var(--t-dense); font-weight: 600; line-height: 1.5; text-decoration: underline; text-underline-offset: 4px; }
  .reset-filters { color: var(--ion); padding: 12px; background: none; border: 0; text-decoration: underline; text-underline-offset: 4px; font-size: var(--t-eyebrow); cursor: pointer; }
  .archive-tools {
    padding: 19px 20px 16px;
    border: var(--bd-inner) solid var(--rule);
    background: var(--panel);
  }
  .tools { display: flex; gap: 14px; flex-wrap: wrap; align-items: end; margin: 18px 0 12px; }
  .search-field { display: grid; gap: 7px; flex: 1; min-width: min(100%, 280px); }
  #q {
    width: 100%; background: var(--ground); color: var(--paper);
    border: var(--bd-input) solid var(--rule-2); padding: 12px 14px;
    font-family: var(--font-text); font-size: var(--t-dense);
  }
  #q::placeholder { color: var(--steel); }
  #q:focus { outline: 2px solid var(--ion); outline-offset: 2px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    background: transparent; color: var(--steel); border: 1px solid var(--rule);
    padding: 10px 12px; font: inherit; font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr);
    text-transform: uppercase; cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .chip:hover { color: var(--paper); border-color: var(--paper); }
  .chip.on { color: var(--ink); border-color: var(--signal); background: var(--signal); }
  .count { display: block; color: var(--ion); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); }
  .empty {
    border: 1px dashed var(--rule-2); padding: 36px 26px; text-align: center; display: grid;
    gap: 12px; justify-items: center; background: var(--ground-deep);
  }
  .empty .dense { max-width: 460px; color: var(--steel); }

  @media (max-width: 900px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
    .tools { align-items: stretch; }
    .search-field { min-width: 100%; }
  }
</style>
