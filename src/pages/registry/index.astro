---
import Base from "../../layouts/Base.astro";
import RegisterCard from "../../components/RegisterCard.astro";
import { allParts } from "../../lib/catalog";
const parts = allParts();
---
<Base title="Parts register — The Ministry of Discontinued Parts"
      sheet={`INDEX · ${parts.length} SHEETS`}>
  <section class="section">
    <p class="index-head">
      <span class="eyebrow">SHEET INDEX — PARTS IN THE REGISTER</span>
      <a class="all-sheets" href="/request/">Missing something? Raise a request →</a>
    </p>
    <h1>The register.</h1>
    <p class="lead reg-lead">
      Every part we know about, whatever its state — from freshly requested to fitted on a real
      car. Sheets live here permanently; the state changes as the work happens.
    </p>

    <div class="tools">
      <input id="q" type="search" enterkeyhint="search"
             placeholder="SEARCH — PART NAME, OEM №, KEYWORD…"
             aria-label="Search the register" autocomplete="off" spellcheck="false" />
      <div class="filters" role="group" aria-label="Filter by state">
        <button type="button" class="chip on" data-state="">All</button>
        <button type="button" class="chip" data-state="measured">Measured</button>
        <button type="button" class="chip" data-state="development">In development</button>
        <button type="button" class="chip" data-state="requested">Requested</button>
      </div>
    </div>
    <p class="eyebrow count" id="count" aria-live="polite"></p>

    <div class="cards" id="grid">
      {parts.map((p, i) => <RegisterCard part={p} sheet={i + 1} total={parts.length} />)}
    </div>

    <div class="empty" id="empty" hidden>
      <p class="eyebrow eyebrow--amber">NO MATCH IN THE REGISTER</p>
      <p class="dense">
        Which means nobody has asked for it yet. Raise a request and it starts existing — every
        sheet above got in exactly this way.
      </p>
      <a class="btn btn--primary" id="empty-cta" href="/request/">Raise a request →</a>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById("q") as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
  const cards = [...document.querySelectorAll<HTMLElement>("#grid .card")];
  const count = document.getElementById("count")!;
  const empty = document.getElementById("empty")!;
  const emptyCta = document.getElementById("empty-cta") as HTMLAnchorElement;
  let state = "";

  function apply(updateUrl = true) {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? "";
      const okState = !state || card.dataset.state === state;
      const okText = terms.every((t) => hay.includes(t));
      const show = okState && okText;
      card.hidden = !show;
      if (show) shown++;
    }
    count.textContent = `SHOWING ${shown} OF ${cards.length}`;
    empty.hidden = shown !== 0;
    emptyCta.href = q ? `/request/?part=${encodeURIComponent(input.value.trim())}` : "/request/";
    if (updateUrl) {
      const url = new URL(location.href);
      if (q) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    }
  }

  input.addEventListener("input", () => apply());
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.toggle("on", c === chip));
      state = chip.dataset.state ?? "";
      apply(false);
    }),
  );
  const initial = new URL(location.href).searchParams.get("q");
  if (initial) input.value = initial;
  apply(false);
</script>

<style>
  .index-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .all-sheets { font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; }
  h1 { margin: 14px 0 16px; }
  .reg-lead { max-width: 620px; }

  .tools { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin: 26px 0 12px; }
  #q {
    flex: 1; min-width: 240px; background: var(--ground-deep); color: var(--paper);
    border: var(--bd-input) solid var(--paper); padding: 11px 14px;
    font-size: var(--t-dense); letter-spacing: .06em;
  }
  #q::placeholder { color: var(--rule); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    background: transparent; color: var(--steel); border: 1px solid var(--rule);
    padding: 8px 12px; font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr);
    text-transform: uppercase; cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .chip:hover { color: var(--paper); border-color: var(--paper); }
  .chip.on { color: var(--amber); border-color: var(--amber); }
  .count { display: block; margin-bottom: 18px; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); }
  .empty { border: 1px dashed var(--rule-2); padding: 34px 26px; text-align: center; display: grid; gap: 12px; justify-items: center; margin-top: 18px; }
  .empty .dense { max-width: 460px; color: var(--steel); }

  @media (max-width: 900px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } }
</style>
