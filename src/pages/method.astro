---
import Base from "../layouts/Base.astro";
import ServiceHeading from "../components/ServiceHeading.astro";

const stages = [
  ["01", "Start with an original or a real interface.", "A replacement starts from a surviving original, donor, or measured mating surface. A new convenience design starts from the actual mounting space and what must stay clear. Photos help explain the problem; measurements establish the fitting dimensions."],
  ["02", "Separate a replacement from a new idea.", "A faithful replacement, repair aid, and OCP3D-original improvement do not make the same claim. The part record keeps its purpose, known facts, and unknowns visible."],
  ["03", "Label drafts as drafts.", "Until a real object or interface has met the calipers, a design is marked In development — visibly, everywhere. A render can show a proposed geometry; it cannot prove fit or function."],
  ["04", "Choose material for where it lives.", "A proof-print material is not automatically a final material. Even shaded interiors can get hot. Choose the exact grade for temperature, sunlight, moisture and load, then evaluate the finished part. Fit or function in one material never transfers automatically to another."],
  ["05", "Check fit, function and conditions.", "A successful fit alone does not prove durability. Check clearance, retention and function, plus the heat, exposure and repeated use relevant to the job. Records stay tied to the actual version, vehicle configuration and material."],
];
---
<Base title="How a Part Is Developed — OCP3D" sheet="DEVELOPMENT · EVIDENCE">
  <section class="lab-page">
    <div class="wrap lab-wrap">
      <ServiceHeading
        eyebrow="BEHIND THE PART / MEASUREMENT, DESIGN & CHECKS"
        title="How a part is developed."
        lede="A useful part starts with understanding its job. Here is how an original or mounting space becomes a design we can evaluate—and why a good-looking render is only one step along the way."
        file="FIVE STEPS"
        facts={[["STARTS WITH", "AN ORIGINAL OR MOUNTING SPACE"], ["ENDS WITH", "A FIT RECORD ON A REAL CAR"], ["A RENDER SHOWS", "SHAPE, NOT FIT"]]}
      />

      <div class="lab-console">
        <div class="lab-intro">
          <p class="eyebrow">THE OPERATING RULE</p>
          <p class="lead">The same evidence standard applies across makes, whether we are replacing something missing or developing an original idea. A prototype helps us learn. A finished part has to earn its own fit, material and function record.</p>
          <p class="dense prose" style="margin-top: 18px">Want to know about scope, costs and working together? <a href="/custom/">Start with custom design.</a></p>
          <div class="readout">
            <span>INPUT</span><b>PHYSICAL ORIGINAL OR INTERFACE</b>
            <span>OUTPUT</span><b>VERSIONED FIT / FUNCTION RECORD</b>
            <span>NOT A SUBSTITUTE FOR</span><b>REAL-CAR VALIDATION</b>
          </div>
        </div>
        <ol class="ladder">
          {stages.map(([n, title, body]) => (
            <li>
              <span class="step-n">{n}</span>
              <div><h2>{title}</h2><p>{body}</p></div>
            </li>
          ))}
        </ol>
      </div>

      <p class="dense prose">Wondering whether a printed part can last in a car? <a href="/materials/">Start with the materials and durability guide.</a></p>

      <aside class="color-note">
        <div class="swatch-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div>
          <p class="eyebrow">MATERIAL &amp; COLOUR NOTE</p>
          <p>Most reproduction trim comes in universal black, even when an interior shipped in Blue, Ivory, Gray, or Beige. Our records retain original colour details so a reproduction can be made to match where the evidence supports it.</p>
        </div>
        <a class="btn btn--secondary" href="/request/">Discuss a part</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .lab-page { background: linear-gradient(180deg, color-mix(in srgb, var(--ground-deep) 28%, transparent), transparent 34%); }
  .lab-wrap { display: grid; gap: 18px; }
  .lab-console { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(0, 1.28fr); border: var(--bd-inner) solid var(--rule-2); background: var(--panel); }
  .lab-intro { padding: 28px; border-right: var(--bd-inner) solid var(--rule); background: var(--ground-deep); }
  .lab-intro .lead { margin-top: 14px; }
  .readout { display: grid; grid-template-columns: 1fr; gap: 5px; margin-top: 24px; padding-top: 16px; border-top: var(--bd-inner) solid var(--rule); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .readout span { color: var(--steel); }
  .readout b { margin-bottom: 7px; color: var(--ion); font-size: var(--t-eyebrow); }
  .ladder { display: grid; counter-reset: steps; }
  .ladder li { display: grid; grid-template-columns: 58px 1fr; gap: 16px; padding: 20px 24px; border-top: var(--bd-inner) solid var(--rule); }
  .ladder li:first-child { border-top: 0; }
  .step-n { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--signal); color: var(--signal); font-size: var(--t-eyebrow); letter-spacing: .08em; }
  .ladder h2 { font-size: 20px; margin-bottom: 8px; }
  .ladder p { color: var(--steel); font-size: var(--t-dense); line-height: var(--t-section-lh); }
  .color-note { display: grid; grid-template-columns: 130px 1fr auto; align-items: center; gap: 22px; padding: 21px 26px; border: var(--bd-inner) solid var(--rule); background: color-mix(in srgb, var(--ground-deep) 84%, transparent); }
  .color-note p:not(.eyebrow) { margin-top: 7px; color: var(--steel); font-size: var(--t-dense); max-width: 64ch; }
  .swatch-line { display: flex; gap: 8px; }
  .swatch-line i { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--paper); }
  .swatch-line i:nth-child(1) { background: #17191B; }
  .swatch-line i:nth-child(2) { background: #55729A; }
  .swatch-line i:nth-child(3) { background: #E8D7B8; }
  .swatch-line i:nth-child(4) { background: #9A937F; }
  @media (max-width: 760px) { .lab-console { grid-template-columns: 1fr; } .lab-intro { border-right: 0; border-bottom: var(--bd-inner) solid var(--rule); } .color-note { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .lab-intro, .ladder li, .color-note { padding: 20px; } .ladder li { grid-template-columns: 42px 1fr; gap: 12px; } }
</style>
