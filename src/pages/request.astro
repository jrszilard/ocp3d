---
import Base from "../layouts/Base.astro";
import ServiceHeading from "../components/ServiceHeading.astro";
---
<Base title="Tell Me About Your Old-Car Project — OCP3D" description="Start a conversation about a missing part or a useful old-car improvement. No CAD file needed. Custom development is scoped and quoted before work starts." sheet="ENQUIRY · A CONVERSATION FIRST">
  <section class="request-page">
    <div class="wrap">
      <ServiceHeading eyebrow="START WITH THE CAR & THE PROBLEM" title="Tell me what you need." lede="A missing piece, a broken original, or a useful improvement. Tell me what you want to solve and I’ll reply personally about the useful next step. No CAD file or technical brief needed." file="A CONVERSATION FIRST" audience="owner" compact />
      <p class="enquiry-boundary" id="enquiry-boundary">This form does not place an order, take payment or promise that a part can be printed. Research-only records accept evidence—not orders or development bookings.</p>

      <div class="intake-layout">
        <div class="form-column">
          <form id="case-form" class="case-file" method="post" action="/api/request" aria-describedby="enquiry-boundary">
            <div class="cf-head"><span class="cf-title">Your enquiry</span><span class="cf-no">THE BASICS ARE ENOUGH TO START</span></div>
            <input type="hidden" name="type" value="request" />
            <input type="hidden" name="part_slug" value="" />
            <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="grid">
              <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
              <label>Email<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
              <label>The car<input type="text" name="vehicle" required placeholder="Year, make, model & trim" /></label>
              <label>The part or problem<input type="text" name="part" required placeholder="Missing trim, broken piece, storage idea…" /></label>
            </div>
            <label class="full"><span id="message-prompt">What would you like to solve?</span>
              <textarea name="message" rows="5" placeholder="What is missing, broken or inconvenient? Tell me what you have access to, your town/region, and any budget or timing constraints you want me to know about."></textarea>
            </label>
            <div class="grid optional-details">
              <label>What do you have? <span class="opt">Optional</span><select name="situation"><option value="" selected>Not sure yet</option><option value="have-part">The old part, even if broken</option><option value="on-car">The part or mounting space on the car</option><option value="gone">The original is missing</option><option value="improvement">An idea for a useful improvement</option></select></label>
              <label>Original part number <span class="opt">Optional — only if you know it</span><input type="text" name="oem" placeholder="No need to research it before asking" /></label>
            </div>
            <p class="photo-note">Have photos? Reply to the confirmation email with them, or email the workshop and include your enquiry number. There is no file upload on this form.</p>
            <div class="cf-foot"><button class="btn btn--primary" type="submit">Send my enquiry <span aria-hidden="true">→</span></button><span class="cap">A personal reply, not an automated quote.</span></div>
            <p class="form-error" id="form-error" role="alert" hidden></p>
          </form>
          <div class="done" id="case-done" role="status" tabindex="-1" hidden>
            <div class="done-stamp">Enquiry received</div>
            <p class="done-case">Your reference: <b id="case-id">—</b></p>
            <p>I’ll reply personally to discuss the useful next step. You can reply to the confirmation email with photos. Nothing has been ordered or paid for.</p>
            <p class="done-alt">Need to add something? Email <a href="mailto:requests@lostclipsociety.com">requests@lostclipsociety.com</a> and include your reference.</p>
          </div>
          <noscript><p class="note">This form also works without JavaScript. You’ll reach a confirmation page, or your mail app will open with the enquiry details.</p></noscript>
        </div>

        <aside class="intake-help" aria-label="Before you send">
          <div id="project-guidance"><p class="eyebrow">NO SURPRISE START</p><h2>Talk first.<br />Agree the work.</h2><p>Custom design and prototyping are paid work. We first discuss suitability, access to the part or mounting space, and what would need to be developed.</p><p>Any paid stage, scope, required checks and costs are agreed before that work begins.</p><a href="/custom/#working-together">How custom projects work →</a></div>
          <div id="research-guidance" hidden><p class="eyebrow">RESEARCH LEADS ONLY</p><h2>This record<br />stays closed.</h2><p>Share a donor, measurement, hardware detail or controlled-test evidence. This is not a quote, fitting, installation, road-use or production enquiry.</p><a id="research-record" href="/registry/">Read the research boundary →</a></div>
          <div class="intake-local" id="intake-local"><p class="eyebrow">A LOCAL WORKSHOP. AN ONLINE START.</p><h3>NH’s Lakes Region.</h3><p>Visits around Rochester, NH, and selected Maine locations by arrangement. Elsewhere? We can first discuss whether a practical measurement and fit-check route exists.</p><p>Please get in touch before sending a part.</p></div>
          <p class="intake-privacy">For your enquiry only. No automatic email-updates signup, tracking pixels or advertising profile.</p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { allParts } from "../lib/catalog";
  import { requestContext } from "../lib/request-context.mjs";
  const form = document.getElementById("case-form") as HTMLFormElement;
  const done = document.getElementById("case-done") as HTMLElement;
  const errBox = document.getElementById("form-error") as HTMLElement;
  const context = requestContext(new URLSearchParams(location.search), allParts());
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
  if (!field("part").value) field("part").value = context.partTitle;
  field("part_slug").value = context.partSlug;
  if (!field("situation").value) field("situation").value = context.situation;
  const sendLabel = context.researchOnly ? "Send research lead" : "Send my enquiry";
  const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;

  if (context.researchOnly) {
    document.getElementById("project-guidance")!.hidden = true;
    document.getElementById("intake-local")!.hidden = true;
    document.getElementById("research-guidance")!.hidden = false;
    document.querySelector(".request-page h1")!.textContent = "Share a research lead.";
    document.querySelector(".request-page .heading-lede")!.textContent = "This record remains research-only. Share evidence that could help resolve its open questions—not an order, a fitting request or a booking for development.";
    document.querySelector(".cf-title")!.textContent = "Your research lead";
    document.querySelector(".done-stamp")!.textContent = "Research lead received";
    document.getElementById("message-prompt")!.textContent = "What evidence can you share?";
    const notes = form.elements.namedItem("message") as HTMLTextAreaElement;
    notes.placeholder = "Share a donor, measurement, hardware detail or controlled-test evidence. Explain the source and any limitations. This record is not open for fitting, production or paid development.";
    const improvement = form.querySelector('option[value="improvement"]') as HTMLOptionElement;
    improvement.disabled = true;
    improvement.hidden = true;
    document.getElementById("research-record")!.setAttribute("href", `/registry/${context.partSlug}/`);
    btn.textContent = sendLabel;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errBox.hidden = true;
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { accept: "application/json" } });
      const data = await res.json();
      if (res.ok && data.ok && typeof data.case === "string") {
        document.getElementById("case-id")!.textContent = data.case;
        form.hidden = true;
        done.hidden = false;
        done.focus({ preventScroll: true });
        done.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth", block: "center" });
      } else if (data.unconfigured) {
        const f = new FormData(form);
        const subject = `OCP3D ${context.researchOnly ? "research lead" : "enquiry"} — ${f.get("part")} (${f.get("vehicle")})`;
        const body = [
          `Name: ${f.get("name")}`, `Email: ${f.get("email")}`, `Vehicle: ${f.get("vehicle")}`,
          `Part or problem: ${f.get("part")}`, `OEM №: ${f.get("oem") || "—"}`,
          `Situation: ${f.get("situation") || "—"}`, "", String(f.get("message") || ""),
        ].join("\n");
        window.location.href = `mailto:requests@lostclipsociety.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      } else { throw new Error("Enquiry was not accepted"); }
    } catch {
      errBox.textContent = "That did not send. Please try again, or email requests@lostclipsociety.com directly. Your details are still here.";
      errBox.hidden = false;
    } finally {
      // Also restore the button if the visitor returns from the mail-app fallback.
      btn.disabled = false;
      btn.textContent = sendLabel;
    }
  });
</script>

<style>
  .request-page .wrap { display: grid; gap: 24px; }
  .enquiry-boundary { max-width: 90ch; color: var(--body); font-size: var(--t-dense); line-height: 1.55; }
  .intake-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, .42fr); gap: 28px; align-items: start; }
  .form-column { min-width: 0; }
  .case-file { background: var(--panel); color: var(--paper); border: 1px solid var(--rule-2); padding: 28px; }
  .cf-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; border-bottom: 2px solid var(--signal); padding-bottom: 13px; margin-bottom: 24px; }
  .cf-title { font-family: var(--font-display); font-size: 25px; text-transform: uppercase; }
  .cf-no { font-size: var(--t-micro); color: var(--body); letter-spacing: .08em; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  label { display: grid; align-content: start; gap: 8px; color: var(--paper); font-family: var(--font-text); font-size: var(--t-dense); font-weight: 600; line-height: 1.4; }
  label .opt { color: var(--body); font-size: 13px; font-weight: 400; }
  input, select, textarea { font: inherit; font-weight: 400; font-size: 16px; padding: 12px; background: var(--ground); border: 1px solid var(--rule); color: var(--paper); min-width: 0; width: 100%; }
  input::placeholder, textarea::placeholder { color: var(--body); opacity: 1; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--ion); outline-offset: 2px; }
  .full, .optional-details { margin-top: 24px; }
  textarea { resize: vertical; line-height: 1.8; }
  .photo-note { margin-top: 23px; color: var(--body); font-size: 14px; line-height: 1.55; }
  .cf-foot { display: flex; align-items: center; gap: 17px; margin-top: 22px; flex-wrap: wrap; }
  .cf-foot .btn { min-height: 48px; gap: 20px; }
  .cf-foot .btn:disabled { opacity: .7; cursor: wait; }
  .cap { font-family: var(--font-text); font-size: 14px; color: var(--body); max-width: 30ch; }
  .form-error { color: var(--signal); font-size: var(--t-dense); margin-top: 18px; }
  .intake-help { background: var(--journal-board); color: var(--ink); padding: 27px; }
  .intake-help .eyebrow { color: var(--ion-light); font-size: var(--t-micro); }
  .intake-help h2 { font-size: 32px; line-height: 1.04; margin: 18px 0; }
  .intake-help h3 { font-size: 24px; margin: 14px 0; line-height: 1.1; }
  .intake-help p:not(.eyebrow) { font-size: var(--t-dense); line-height: 1.6; color: var(--inv-body); }
  .intake-help p + p { margin-top: 15px; }
  .intake-help a { display: inline-block; margin-top: 20px; color: var(--acid); font-family: var(--font-text); font-size: var(--t-dense); font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .intake-local { border-top: 1px solid var(--inv-label); margin-top: 28px; padding-top: 25px; }
  .intake-help .intake-privacy { border-top: 1px solid var(--inv-label); margin-top: 25px; padding-top: 20px; font-size: 14px; }
  .done { background: var(--panel); border: 1px solid var(--rule-2); padding: 30px; }
  .done-stamp { display: inline-block; color: var(--ion); font-family: var(--font-display); font-size: 28px; margin-bottom: 15px; }
  .done p { color: var(--body); margin-top: 16px; }
  .done-case b { color: var(--paper); }
  .done-alt { font-size: 14px; overflow-wrap: anywhere; }
  .done-alt a, .note a { color: var(--ion); text-decoration: underline; text-underline-offset: 3px; }
  .note { font-size: 14px; margin-top: 18px; color: var(--body); }
  @media (max-width: 850px) { .intake-layout { grid-template-columns: 1fr; } .intake-help { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; } .intake-local { margin: 0; padding: 0; border: 0; } .intake-help .intake-privacy { grid-column: 1 / -1; margin: 0; } }
  @media (max-width: 560px) { .grid, .intake-help { grid-template-columns: 1fr; } .case-file, .intake-help, .done { padding: 22px; } .intake-local { border-top: 1px solid var(--inv-label); padding-top: 23px; } }
</style>
