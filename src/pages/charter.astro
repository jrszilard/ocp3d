---
import Base from "../layouts/Base.astro";
import ServiceHeading from "../components/ServiceHeading.astro";
import TheCar from "../components/TheCar.astro";

const articles = [
  {
    n: "01",
    title: "The work",
    body: [
      `A small, founder-led workshop in New Hampshire’s Lakes Region. I design and prototype parts for
       old cars of any make: replacing what’s missing, or adding something useful the car never had
       (labelled as an original design, never passed off as OEM).`,
      `Pre-2000, unbranded, non-safety-critical parts only. The parts cost money. The measurements never
       do: every measured dimension is published free.`,
    ],
  },
  {
    n: "02",
    title: "The old car problem",
    body: [
      `A discontinued clip, a cracked knob, a missing vent: small things that turn a good car into a
       frustrating one. A 3D print isn’t magic, but it’s a fast way to test a shape and keep a car in use.`,
    ],
  },
  {
    n: "03",
    title: "Where it started. Not where it stops.",
    body: [
      `My ’83 Supra started this. It’s an example, not the limit: bring a problem from any make, and we
       measure your car rather than assume something that fit mine will fit yours.`,
    ],
  },
  {
    n: "04",
    title: "Keep the car. Not a profile of you.",
    body: [
      `Modern cars log where you go. An old car without a modem is a private machine, and this site works
       the same way: no trackers, analytics, ad pixels or third-party scripts.`,
    ],
  },
];

const retention = [
  ["TRACKERS", "0"],
  ["THIRD-PARTY SCRIPTS", "0"],
  ["ANALYTICS, AD PIXELS, SESSION RECORDING", "0"],
  ["DETAILS ASKED FOR ON EMAIL-UPDATES SIGNUP", "Your email address"],
  ["WHAT IT IS USED FOR", "OCP3D email updates. Nothing else."],
  ["SOLD FOR ADVERTISING", "Never"],
  ["PART ENQUIRIES", "Contact and project details, used to respond to you"],
  ["AUTOMATIC EMAIL-UPDATES SIGNUP FROM AN ENQUIRY", "No"],
  ["WAY OUT", "Unsubscribe from email updates, or email the workshop"],
];
---
<Base title="About the Workshop — OCP3D" description="An independent old-car design and prototyping workshop in New Hampshire’s Lakes Region. The founder’s Supra is the origin, not the market boundary." sheet="ABOUT · THE WORKSHOP">
  <section class="charter-page">
    <div class="wrap charter-wrap">
      <ServiceHeading
        eyebrow="ONE PERSON’S WORKSHOP / NH’S LAKES REGION"
        title="Keep the old car useful."
        lede="I started with the small problems on my own car. Now I help with yours."
        file="THE PERSON BEHIND THE PART"
        audience="owner"
      />

      <TheCar />

      <div class="mission-rule">
        <span class="rule-mark" aria-hidden="true">OCP3D</span>
        <p>You shouldn’t need CAD to ask about a missing part. Bring the problem.</p>
      </div>

      <div class="articles">
        {articles.map((a) => (
          <article class="article">
            <div class="art-no"><span class="eyebrow">WORKSHOP NOTE</span><span class="numeral">{a.n}</span></div>
            <div class="art-body prose">
              <h2>{a.title}</h2>
              {a.body.map((p) => <p>{p}</p>)}
            </div>
          </article>
        ))}
      </div>

      <section class="retention-panel">
        <div class="retention-head">
          <div><p class="eyebrow eyebrow--amber">PRIVACY — THE FACTS, STATED EXACTLY</p><h2>What we keep. What we do not.</h2></div>
        </div>
        <div class="retention">
          {retention.map(([k, v]) => (
            <><div><span class="eyebrow">{k}</span></div><div><span class="ret-v">{v}</span></div></>
          ))}
        </div>
        <p class="dense note">Hosting and email services process enquiries so I can reply. If analytics are ever added, this list changes first.</p>
      </section>

      <div class="mission-actions">
        <a class="btn btn--primary" href="/request/">Tell me about your project</a>
        <a class="btn btn--secondary" href="/custom/">Explore custom design</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .charter-page { background: linear-gradient(180deg, color-mix(in srgb, var(--ground-deep) 25%, transparent), transparent 37%); }
  .charter-wrap { display: grid; gap: 18px; }
  .mission-rule { display: grid; grid-template-columns: 160px 1fr; gap: 22px; align-items: center; padding: 22px 26px; border: var(--bd-inner) solid var(--rule); background: color-mix(in srgb, var(--ground-deep) 80%, transparent); }
  .rule-mark { font-family: var(--font-display); font-size: 24px; letter-spacing: .06em; color: var(--signal); }
  .mission-rule p { max-width: 72ch; color: var(--body); }
  .articles { border: var(--bd-inner) solid var(--rule-2); }
  .article { display: grid; grid-template-columns: 160px 1fr; gap: 30px; padding: 27px 30px; border-top: var(--bd-inner) solid var(--rule); background: var(--panel); }
  .article:first-child { border-top: 0; }
  .article:nth-child(even) { background: var(--ground-deep); }
  .art-no { display: flex; flex-direction: column; gap: 7px; }
  .numeral { font-family: var(--font-display); font-size: 45px; line-height: 1; color: var(--signal); }
  .art-body { max-width: 700px; }
  .art-body h2, .retention-head h2 { font-size: 27px; margin-bottom: 14px; }
  .art-body p + p { margin-top: 14px; }
  .art-body p { color: var(--body); }
  .retention-panel { border: var(--bd-inner) solid var(--rule-2); background: var(--panel); }
  .retention-head { display: flex; align-items: end; justify-content: space-between; gap: 22px; padding: 25px 30px 18px; border-bottom: var(--bd-inner) solid var(--rule); }
  .retention-head .dense { max-width: 42ch; color: var(--steel); }
  .retention { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(240px, .7fr); background: var(--rule); gap: var(--bd-inner); }
  .retention > div { padding: 12px 16px; background: var(--ground-deep); }
  .ret-v { color: var(--paper); font-family: var(--font-text); font-size: var(--t-dense); font-weight: 600; }
  .note { margin: 15px 30px 22px; color: var(--steel); max-width: 620px; }
  .mission-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; padding: 10px 0; }
  @media (max-width: 760px) { .mission-rule, .article { grid-template-columns: 1fr; } .mission-rule { gap: 8px; } .art-no { flex-direction: row; align-items: baseline; gap: 10px; } .retention-head { align-items: flex-start; flex-direction: column; } .retention { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .mission-rule, .article, .retention-head { padding: 20px; } .note { margin-inline: 20px; } }
</style>
