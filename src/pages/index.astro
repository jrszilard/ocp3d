---
import Base from "../layouts/Base.astro";
import parts from "../data/parts.json";
import RegisterCard from "../components/RegisterCard.astro";
import WorkshopHelper from "../components/WorkshopHelper.astro";

/* The register is the product, so the cards are driven from the committed
   catalogue snapshot, never from markup. One card per state, in the order the
   sheet index runs: what is measured, what is moving, what is still owed. */
const pick = (state: string) => parts.find((p: any) => p.state === state);
const cards = [pick("measured"), pick("development"), pick("requested")].filter(Boolean);

const visor: any = parts.find((p: any) => p.slug === "sun-visor-clip");
const dim = (name: string) => visor?.dims.find((d: any) => d.name === name)?.mm;

/* Four headline dimensions off the real record. The design reference showed
   "18 DIMS"; the record says 20, and the record wins — the whole argument of
   the site is that these numbers are true. */
const measured = [
  { label: "OVERALL L", value: dim("overall_length")?.toFixed(2) },
  { label: "WIDTH", value: dim("overall_width")?.toFixed(2) },
  { label: "HOOK Ø", value: dim("hook_inner_diameter")?.toFixed(2) },
  { label: "WALL T", value: dim("hook_wall_thickness")?.toFixed(2) },
];
const printed = [
  { label: "NOZZLE Ø", value: "0.40" },
  { label: "LAYER", value: "0.12" },
  { label: "INFILL", value: "60%" },
  { label: "WALLS", value: "4" },
];
const notes = [
  "Pre-2000, unbranded, non-safety-critical parts only.",
  "Every file says what is measured, estimated, or still unknown.",
  "3D printing solves geometry; real-car fit earns its own record.",
  "No trackers, no telemetry, no mystery data.",
];
const steps = [
  { n: 1, title: "Log",     text: "Tell us the car, the part, and what went wrong. Every problem starts as a field file." },
  { n: 2, title: "Trace",   text: "We map surviving originals and the interfaces still on the vehicle." },
  { n: 3, title: "Measure", text: "Original on the bench. Every critical dimension published free." },
  { n: 4, title: "Build",   text: "Modelled in-house and 3D printed one layer at a time. If it misses, we learn and remake." },
  { n: 5, title: "Run",     text: "Tested on a real car. Vehicle, material, and result stay on the record." },
];
const facts = [
  { n: "0",  label: "TRACKERS" },
  { n: "0",  label: "THIRD-PARTY SCRIPTS" },
  { n: "1",  label: "FIELD STORED: EMAIL" },
  { n: "±0", label: "TOLERANCE ON THAT" },
];
const dimsOnRecord = visor?.dimsConfirmed ?? 0;
---

<Base title="OCP3D — Old Car Problems. New parts in layers.">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero-text">
      <p class="projection">
        <span class="glyph" aria-hidden="true"></span>
        OCP3D FIELD MANUAL · ALL DIMS IN MILLIMETRES
      </p>
      <h1>Old car problem.<br />New part, in layers.</h1>
      <p class="lead">
        OCP3D puts surviving parts and stubborn interfaces on the bench, then measures, models,
        and 3D prints the next useful version. Dimensions stay free, real-car fit stays on the
        record, and old vehicles keep their place in the future.
      </p>
      <p class="hero-actions">
        <a class="btn btn--primary" href="/registry/">Browse parts</a>
        <a class="btn btn--secondary" href="/request/">Log a problem</a>
      </p>

      <div class="notes">
        <p class="eyebrow">GENERAL NOTES</p>
        <ol>
          {notes.map((t, i) => (
            <li><span class="num">{i + 1}.</span><span class="dense">{t}</span></li>
          ))}
        </ol>
      </div>
    </div>

    <div class="hero-pane">
      <div class="pane-grid" aria-hidden="true"></div>
      <div class="centre-v" aria-hidden="true"></div>
      <div class="centre-h" aria-hidden="true"></div>
      <div class="views placeholder">
        <WorkshopHelper size={78} />
        <span>ORBITAL SERVICE VIEW</span>
        <small>helper cart · scan · measure · model</small>
        <small>first case: sun visor retaining clip</small>
      </div>
      <p class="pane-caption">
        <span class="eyebrow">FIELD VIEW · LAYER 01</span>
        <span class="chips">
          <span class="chip chip--amber">{dimsOnRecord} DIMS ON FILE</span>
          <span class="chip chip--solid">MEASURED</span>
        </span>
      </p>
    </div>
  </section>

  <!-- ========================= SPEC BAND =========================
       What was measured, beside what it was printed to. This pairing is the
       core argument of the site — keep them side by side above mobile. -->
  <section class="spec-band">
    <div class="spec-col">
      <p class="eyebrow">RECOVERED FROM THE ORIGINAL</p>
      <div class="hairline-grid spec-grid">
        {measured.map((m) => (
          <div><span class="eyebrow">{m.label}</span><span class="spec-value">{m.value}</span></div>
        ))}
      </div>
      <p class="dense foot">
        {visor?.dimsTotal} dimensions on record · published free, whether you buy or not
      </p>
    </div>
    <div class="spec-col">
      <p class="eyebrow eyebrow--amber">BUILT IN 3D</p>
      <div class="hairline-grid spec-grid">
        {printed.map((m) => (
          <div><span class="eyebrow">{m.label}</span><span class="spec-value">{m.value}</span></div>
        ))}
      </div>
      <p class="dense foot materials">
        <span class="eyebrow">MATERIAL:</span>
        <span class="mat"><i style="background:var(--mat-asa)"></i>ASA</span>
        <span class="mat"><i style="background:var(--mat-petg)"></i>PETG</span>
        <span class="mat"><i style="background:var(--mat-nylon-cf)"></i>NYLON CF</span>
      </p>
    </div>
  </section>

  <!-- ==================== SEQUENCE OF OPERATIONS ==================== -->
  <section class="section sequence-wrap">
    <p class="eyebrow">SERVICE SEQUENCE</p>
    <ol class="hairline-grid sequence">
      {steps.map((s) => (
        <li class={s.n === 1 ? "is-current" : ""}>
          <span class="balloon">{s.n}</span>
          <h3>{s.title}</h3>
          <p class="dense">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ======================= PARTS REGISTER ======================= -->
  <section class="section">
    <p class="index-head">
      <span class="eyebrow">FIELD INDEX — PARTS ARCHIVE</span>
      <a class="all-sheets" href="/registry/">All {parts.length} files →</a>
    </p>
    <div class="cards">
      {cards.map((p: any, i: number) => (
        <RegisterCard part={p} sheet={i + 1} total={parts.length} />
      ))}
    </div>
  </section>

  <!-- ======================== ARTICLE IV =========================
       The only inverted band on the page. Counted facts, not adjectives. -->
  <section class="article-iv">
    <div class="iv-text">
      <p class="eyebrow iv-eyebrow">OCP3D TRANSMISSION RULE</p>
      <h2>Keep the car running.<br />Not a profile of you.</h2>
      <p class="iv-body">
        A car drawn on paper in 1983 has no modem, no subscription and no privacy policy. OCP3D
        keeps the same line: no trackers, analytics, ad pixels, or third-party scripts. One
        address is kept for the Dispatch, with one click to leave every issue.
      </p>
      <p><a class="iv-link" href="/charter/">Read the mission →</a></p>
    </div>
    <div class="iv-facts">
      {facts.map((f) => (
        <div><span class="fact-n">{f.n}</span><span class="fact-l">{f.label}</span></div>
      ))}
    </div>
  </section>

  <!-- ======================= REGISTRATION ======================= -->
  <section class="registration" id="register">
    <div class="reg-text">
      <p class="eyebrow">OCP3D DISPATCH — NO CHARGE</p>
      <h2>Get the next signal.</h2>
      <p class="lead">
        Free, quiet, and sent only when a part actually moves forward — never on a schedule.
        Voting is open to everyone. The parts cost money. The Dispatch does not.
      </p>
      <form class="reg-form" id="join-form" method="post" action="/api/request">
        <input type="hidden" name="type" value="membership" />
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="email" name="email" required placeholder="you@garage.example" aria-label="Email address" />
        <button class="btn btn--primary" type="submit">GET THE DISPATCH</button>
      </form>
      <p class="reg-done dense" id="join-done" hidden></p>
      <p class="dense reg-note">
        We keep your address for the Dispatch, and for nothing else — never sold, never shared.
      </p>
    </div>

    <div class="reg-block">
      <div class="tb-head">
        <span class="eyebrow">FIELD FILE · DISPATCH RECORD</span>
        <span class="eyebrow">SIGNAL 0001</span>
      </div>
      <div class="hairline-grid tb-grid">
        <div><span class="eyebrow">VEHICLE</span></div><div><span class="tb-v">A60 · Celica Supra</span></div>
        <div><span class="eyebrow">CHANNEL</span></div><div><span class="tb-v">OCP3D Dispatch</span></div>
        <div><span class="eyebrow">SIGNAL</span></div><div><span class="tb-v">1 part · {dimsOnRecord} dims</span></div>
        <div><span class="eyebrow">EST.</span></div><div><span class="tb-v">2026</span></div>
      </div>
      <p class="oath">"Measure twice. Keep it moving."</p>
    </div>
  </section>
</Base>

<script>
  const joinForm = document.getElementById("join-form") as HTMLFormElement | null;
  const joinDone = document.getElementById("join-done") as HTMLElement | null;
  joinForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(joinForm);
    const email = String(data.get("email") || "");
    // Validate on submit only, never while typing.
    try {
      const res = await fetch(joinForm.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      if (!res.ok) throw new Error(String(res.status));
      const body = await res.json().catch(() => ({} as any));
      const num = body?.number ? `№ ${body.number}` : "№ 0002";
      // Success replaces the form block, keeping the layout height stable.
      if (joinDone) {
        joinDone.textContent = `File ${num} — the OCP3D Dispatch will find you when a part moves.`;
        joinDone.hidden = false;
      }
      joinForm.hidden = true;
    } catch {
      window.location.href = `mailto:requests@lostclipsociety.com?subject=${encodeURIComponent(
        "OCP3D Dispatch signup",
      )}&body=${encodeURIComponent("Sign me up: " + email)}`;
    }
  });
</script>

<style>
  /* ---- hero ------------------------------------------------------------ */
  .hero { display: grid; grid-template-columns: 1fr 46%; }
  .hero-text { padding: var(--sec-hero); }
  .projection {
    display: flex; align-items: center; gap: 10px; margin-bottom: 26px;
    font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr);
    text-transform: uppercase; color: var(--steel);
  }
  /* the first-angle-projection glyph: a half-ellipse outline, open at the foot */
  .glyph {
    width: 26px; height: 13px; border: 1px solid var(--steel); border-bottom: 0;
    border-radius: 50% / 100% 100% 0 0; flex: none;
  }
  .hero h1 { margin-bottom: 22px; }
  .hero .lead { max-width: 470px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0 36px; }

  .notes { border: var(--bd-inner) solid var(--rule); background: var(--ground-deep); padding: 18px 20px; }
  .notes ol { display: grid; gap: 9px; margin-top: 12px; }
  .notes li { display: grid; grid-template-columns: 18px 1fr; align-items: start; }
  .num { font-size: var(--t-dense); color: var(--steel); }

  .hero-pane {
    position: relative; background: var(--ground-deep);
    border-left: var(--bd-section) solid var(--paper);
    padding: 26px; display: flex; flex-direction: column; gap: 14px;
  }
  .pane-grid {
    position: absolute; inset: 0; background-image: var(--grid-28);
    background-size: 28px 28px; pointer-events: none;
  }
  .centre-v, .centre-h { position: absolute; pointer-events: none; opacity: .55; }
  .centre-v { left: 50%; top: 0; bottom: 0; border-left: 1px dashed var(--amber); }
  .centre-h { top: 42%; left: 0; right: 0; border-top: 1px dashed var(--amber); }
  .views { position: relative; flex: 1; min-height: 320px; color: var(--ion); }
  .pane-caption {
    position: relative; display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
  }
  .chips { display: flex; gap: 8px; }
  .chip {
    font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase;
    padding: 5px 10px; white-space: nowrap;
  }
  .chip--amber { border: 1px solid var(--amber); color: var(--amber); }
  .chip--solid { background: var(--paper); color: var(--ink); font-weight: 600; }

  /* ---- spec band ------------------------------------------------------- */
  .spec-band {
    display: grid; grid-template-columns: 1fr 1fr;
    border-top: var(--bd-section) solid var(--paper);
  }
  .spec-col { padding: var(--sec-dense); }
  .spec-col + .spec-col { border-left: var(--bd-section) solid var(--paper); }
  .spec-grid { grid-template-columns: repeat(4, 1fr); margin: 14px 0; }
  .spec-grid > div { display: flex; flex-direction: column; gap: 6px; }
  .foot { color: var(--steel); }
  .materials { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .mat { display: inline-flex; align-items: center; gap: 6px; font-size: var(--t-dense); }
  .mat i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

  /* ---- sequence -------------------------------------------------------- */
  .sequence-wrap { padding-bottom: 0; }
  .sequence { grid-template-columns: repeat(5, 1fr); margin-top: 14px; }
  .sequence > li { padding: 20px 16px 26px; display: flex; flex-direction: column; gap: 10px; }
  .balloon {
    width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--paper);
    display: grid; place-items: center; font-size: var(--t-dense); color: var(--paper);
  }
  /* step 1 is the front of the queue, and the only amber thing here */
  .is-current .balloon { border-color: var(--amber); color: var(--amber); }
  .sequence h3 { font-size: var(--h-step); letter-spacing: var(--h-step-tr); }

  /* ---- register cards -------------------------------------------------- */
  .index-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .all-sheets { font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); margin-top: 16px; }

  /* ---- Article IV (inverted) ------------------------------------------- */
  .article-iv {
    display: grid; grid-template-columns: 1fr 380px; gap: 40px;
    background: var(--paper); color: var(--ink); padding: var(--sec-state);
    border-top: var(--bd-section) solid var(--paper);
  }
  .iv-eyebrow { color: var(--inv-gold); }   /* amber on paper fails contrast */
  .article-iv h2 { margin: 10px 0 16px; }
  .iv-body { color: var(--inv-body); font-size: var(--t-section); line-height: var(--t-section-lh); }
  .iv-link { color: var(--inv-gold); text-decoration: underline; text-underline-offset: 3px; margin-top: 14px; display: inline-block; }
  .iv-link:hover { color: var(--ink); }
  .iv-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-content: start; }
  .iv-facts > div { display: flex; flex-direction: column; gap: 4px; }
  .fact-n { font-family: var(--font-display); font-weight: 700; font-size: var(--h-fact); color: var(--ink); line-height: 1; }
  .fact-l { font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; color: var(--inv-label); }

  /* ---- registration ---------------------------------------------------- */
  .registration {
    display: grid; grid-template-columns: 1fr 420px; gap: 40px;
    padding: var(--sec-state); border-top: var(--bd-section) solid var(--paper);
  }
  .registration h2 { margin: 10px 0 16px; }
  .reg-form { display: flex; margin: 26px 0 12px; max-width: 520px; }
  .reg-form input[type="email"] {
    flex: 1; min-width: 0; background: var(--ground-deep); color: var(--paper);
    border: var(--bd-input) solid var(--paper); border-right: 0; padding: 12px 14px;
    font-size: var(--t-dense);
  }
  .reg-form input::placeholder { color: var(--rule); }
  .reg-form .btn { white-space: nowrap; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .reg-note, .reg-done { color: var(--steel); max-width: 520px; }
  .reg-done { color: var(--amber); }

  .reg-block { border: var(--bd-inner) solid var(--rule); align-self: start; }
  .tb-head {
    display: flex; justify-content: space-between; gap: 10px; padding: 12px 14px;
    border-bottom: var(--bd-inner) solid var(--rule);
  }
  .tb-grid { grid-template-columns: 110px 1fr; }
  .tb-grid > div { padding: 11px 14px; }
  .tb-v { font-size: var(--t-dense); color: var(--paper); }
  .oath { padding: 14px; font-style: italic; font-size: var(--t-dense); color: var(--steel);
          border-top: var(--bd-inner) solid var(--rule); }

  /* ---- responsive ------------------------------------------------------ */
  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; }
    .hero-pane { border-left: 0; border-top: var(--bd-section) solid var(--paper); }
    .article-iv, .registration { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 900px) {
    .sequence { grid-template-columns: 1fr 1fr; }
    .cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .spec-band { grid-template-columns: 1fr; }
    .spec-col + .spec-col { border-left: 0; border-top: var(--bd-section) solid var(--paper); }
  }
  @media (max-width: 600px) {
    .sequence { grid-template-columns: 1fr; }
    .cards { grid-template-columns: 1fr; }
    .spec-grid { grid-template-columns: 1fr 1fr; }
    .reg-form { flex-direction: column; }
    .reg-form input[type="email"] { border-right: var(--bd-input) solid var(--paper); }
  }
</style>
