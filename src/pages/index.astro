---
import Base from "../layouts/Base.astro";
import RegisterCard from "../components/RegisterCard.astro";
import OfferPaths from "../components/OfferPaths.astro";
import BenchLogs from "../components/BenchLogs.astro";
import MaterialQuestions from "../components/MaterialQuestions.astro";
import WantedList from "../components/WantedList.astro";
import { allParts } from "../lib/catalog";
import { materialSources } from "../data/materials.mjs";
import { car } from "../data/car.mjs";

const parts = allParts();
const pick = (state: string) => parts.find((part) => part.state === state && !part.safetyGated);
// Evidence first, then the closed research record. Requested parts appear as the wanted list, not as empty cards.
const cards = [pick("fitted") ?? pick("measured") ?? pick("development"), parts.find((part) => part.safetyGated)].filter(Boolean);
const carPhoto = car.photos[0];
const porscheSource = materialSources.find((source) => source.id === "porsche")!;

const conditions = [
  { n: "01", icon: "heat", title: "A car parked in the sun.", material: "HEAT RESISTANCE", body: "A shape-checking prototype and a part for a hot cabin need different decisions. ASA offers better heat resistance than ordinary PLA; the finished part still needs checking under its actual load.", link: "Why the plastic matters", href: "/materials/#material-asa" },
  { n: "02", icon: "sun", title: "Sunlight, day after day.", material: "UV RESISTANCE", body: "Not every plastic weathers the same way. ASA is a UV-resistant candidate. That material property is a reason to investigate it—not a claim that an OCP3D exterior part is ready for use.", link: "Understand exposure", href: "/materials/#material-asa" },
  { n: "03", icon: "load", title: "The thousandth time you use it.", material: "FLEX, WEAR & LOAD", body: "A clip may need to flex; a holder may need to stay rigid. Nylon, PETG and ASA behave differently. Material choice, print direction and repeated-use testing need to match the job.", link: "Match the material to the job", href: "/materials/#compare" },
];
---

<Base
  title="OCP3D — Old cars. Modern materials."
  description="Hard-to-find parts. Useful new ideas. Explore OCP3D’s parts in development or discuss custom design and 3D-printing for pre-2000 cars across makes. Based in New Hampshire’s Lakes Region."
  sheet="PARTS · CUSTOM DESIGN"
>
  <div class="durability-home">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">AN INDEPENDENT WORKSHOP / NEW HAMPSHIRE</p>
        <h1 id="home-title">Old cars.<br /><span>Modern<br /> materials.</span></h1>
        <p class="hero-lead">Hard-to-find parts. Useful new ideas.</p>
        <p class="hero-body">A small missing piece shouldn’t mean giving up on the car. OCP3D designs and prototypes 3D-printed solutions for old-car problems—across makes and models, not just the car in my garage.</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/custom/">EXPLORE CUSTOM DESIGN <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/registry/">Parts &amp; projects <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-scope">Pre-2000 · Unbranded · Non-safety-critical<br />A conversation first. No CAD file needed.</p>
      </div>

      <aside class="bench-board" aria-label="Genuine founder work, not a customer success story">
        <div class="board-heading"><span>REAL PART. REAL BENCH.</span><span>FOUNDER PROJECT / 001</span></div>
        <figure class="design-study">
          <img src="/images/hero/measured.jpg" alt="Original reference part beside a ruler on the founder’s measurement bench" width="1280" height="960" fetchpriority="high" />
          <figcaption><span class="drawing-label">ORIGINAL PART</span><span>Actual bench photograph · not a printed replacement</span></figcaption>
        </figure>
        <div class="bench-reference">
          <img src={carPhoto.src} alt={carPhoto.alt} width={carPhoto.width} height={carPhoto.height} />
          <div><p class="eyebrow">THE CAR / MY ’83 SUPRA</p><h2>One old car started this.<br /> Not one kind of customer.</h2><p>My 1983 Celica Supra is the starting point, not the limit.</p></div>
        </div>
        <div class="study-status"><p>Sun visor clip: v12 has been in the car since Sept 8. Its fit record isn’t filed yet, and durability isn’t established.</p><a href="/journal/sun-visor-clip/">Read how it got there <span aria-hidden="true">→</span></a></div>
      </aside>
    </section>

    <OfferPaths />

    <BenchLogs />

    <section class="plastic-statement" aria-labelledby="plastic-title">
      <div><p class="eyebrow">PLASTIC ISN’T NEW TO CARS.</p><h2 id="plastic-title">Making one at a time<br />is the difference.</h2></div>
      <div><p>Clips. Trim. Knobs. Housings. Cars already rely on plastics for plenty of everyday jobs. 3D printing can make small runs possible when making a new mould does not make sense.</p><p class="statement-note">A printed part is not automatically equivalent to a moulded one. Its material, construction and performance still have to suit the job.</p></div>
    </section>

    <section class="conditions" aria-labelledby="conditions-title">
      <div class="section-heading"><div><p class="eyebrow">START WITH LIFE IN THE CAR</p><h2 id="conditions-title">The job chooses<br />the material.</h2></div><p>You don’t need to know filament names.<br />You need to know what your part has to live with.</p></div>
      <div class="condition-grid">
        {conditions.map((condition) => (
          <article class="condition-card">
            <div class="condition-top"><span>{condition.n} / {condition.material}</span>
              <svg viewBox="0 0 48 48" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                {condition.icon === "heat" ? <><path d="M20 29V9a4 4 0 0 1 8 0v20a9 9 0 1 1-8 0Z" /><path d="M24 16v19m10-20h6m-6 8h4" /><circle cx="24" cy="36" r="3" /></> : condition.icon === "sun" ? <><circle cx="24" cy="24" r="9" /><path d="M24 2v7m0 30v7M2 24h7m30 0h7M8 8l5 5m22 22 5 5M8 40l5-5m22-22 5-5" /></> : <><path d="M8 18h32v12H8zM16 18v12m8-12v12m8-12v12M24 2v10m-4-4 4 4 4-4M24 46V36m-4 4 4-4 4 4" /></>}
              </svg>
            </div>
            <h3>{condition.title}</h3><p>{condition.body}</p><a href={condition.href}>{condition.link} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <p class="conditions-note">Material families are a starting point—not a universal “car-safe” rating. <a href="/materials/#compare">Compare PLA, PETG, ASA and nylon →</a></p>
    </section>

    <section class="industry-note" aria-labelledby="industry-title">
      <p class="eyebrow">BEYOND DESKTOP TRINKETS</p>
      <div><h2 id="industry-title">Even classic-car spares are being printed.</h2><p>Porsche Classic has documented making replacement parts using 3D printing, including plastics. The important detail: materials and testing are chosen for the application.</p><p class="industry-boundary">Their plastic process is powder-based SLS; OCP3D uses filament printing. This is an industry example, not an endorsement or evidence for an OCP3D part.</p></div>
      <a class="text-link" href={porscheSource.href}>Read Porsche’s account <span aria-hidden="true">↗</span></a>
    </section>

    <section class="questions-section" aria-labelledby="questions-title">
      <div><p class="eyebrow">FAIR QUESTIONS. STRAIGHT ANSWERS.</p><h2 id="questions-title">“But will it<br /> actually last?”</h2><p>That is the right question to ask.<br />Here is what matters beyond the word “printed.”</p><a class="text-link" href="/materials/">The plain-English materials guide <span aria-hidden="true">→</span></a></div>
      <MaterialQuestions />
    </section>

    <section class="field-index" aria-labelledby="evidence-title">
      <div class="section-heading"><div><p class="eyebrow">THE EVIDENCE SO FAR / OPEN WORKSHOP</p><h2 id="evidence-title">A material can be capable.<br />A part still has to prove it.</h2></div><a class="text-link" href="/registry/">All {parts.length} part records <span aria-hidden="true">→</span></a></div>
      <p class="index-intro">This is founder work, not a gallery of customer success stories. The collection began with my Supra; the service welcomes eligible old-car problems across makes. These records show what is measured, what is missing, and what still needs testing—not a ready-to-buy range.</p>
      <div class="cards">{cards.map((part) => <RegisterCard part={part} />)}<WantedList parts={parts} compact id="home-wanted" /></div>
      <p class="index-note">The wiper-adaptor file remains research-only with its safety review open. No installation, road-use or availability claim is made. A successful fit alone does not establish heat resistance, fatigue life or retention.</p>
    </section>

    <section class="workshop-section" aria-labelledby="workshop-title">
      <div class="workshop-copy"><p class="eyebrow">ONE PERSON’S WORKSHOP / NH’S LAKES REGION</p><h2 id="workshop-title">Start online.<br />Meet where it helps.</h2><p>Tell me about the car and the small thing you want to solve. You’ll speak to the person doing the design—not a print-upload calculator. We’ll first work out whether an existing part, a repair, or a new design makes sense.</p><div class="hero-actions"><a class="btn btn--primary" href="/request/">TELL ME ABOUT YOUR PROJECT <span aria-hidden="true">→</span></a><a class="text-link" href="/custom/#working-together">What happens next →</a></div><p class="request-note">Custom development is paid work. Scope and costs are agreed before it begins.</p></div>
      <div class="part-paths"><article><span>LOCAL ACCESS / BY ARRANGEMENT</span><h3>New Hampshire &amp; parts of Maine.</h3><p>Based in the Lakes Region, with visits around Rochester, NH, and selected Maine locations by arrangement. Sometimes seeing the original or mounting space is the useful next step.</p></article><article><span>FURTHER AWAY? START WITH THE PROBLEM.</span><h3>You don’t need my car.</h3><p>We can discuss a removable original, access to your vehicle or guided measurement. We’ll establish a practical route before agreeing to work. Please get in touch before sending a part.</p></article></div>
    </section>

    <section class="dispatch" id="register" aria-labelledby="dispatch-title">
      <div><p class="eyebrow">EMAIL UPDATES / OCCASIONAL BENCH NOTES</p><h2 id="dispatch-title">Follow the parts. See the results.</h2><p>Real progress when there is something to report. No feed, no membership gate, no noise.</p></div>
      <div class="dispatch-signup">
        <form class="dispatch-form" id="join-form" method="post" action="/api/request">
          <input type="hidden" name="type" value="membership" />
          <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label for="dispatch-email">YOUR EMAIL ADDRESS</label>
          <div class="dispatch-fields"><input id="dispatch-email" type="email" name="email" required placeholder="you@garage.example" /><button class="btn btn--primary" type="submit">GET EMAIL UPDATES →</button></div>
        </form>
        <p class="dispatch-done" id="join-done" role="status" aria-live="polite" hidden></p>
        <p class="dispatch-note">For these updates only. Never sold or used to build a profile.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const joinForm = document.getElementById("join-form") as HTMLFormElement | null;
  const joinDone = document.getElementById("join-done") as HTMLElement | null;
  joinForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(joinForm);
    const email = String(data.get("email") || "");
    try {
      const res = await fetch(joinForm.action, {
        method: "POST",
        headers: { accept: "application/json" },
        body: data,
      });
      const body = await res.json();
      if (!res.ok || !body.ok) throw new Error(String(res.status));
      const num = body?.case ? `№ ${body.case}` : "on file";
      if (joinDone) {
        joinDone.textContent = `You’re on the list (${num}). I’ll write when a part actually moves forward.`;
        joinDone.hidden = false;
      }
      joinForm.hidden = true;
    } catch {
      window.location.href = `mailto:requests@lostclipsociety.com?subject=${encodeURIComponent(
        "OCP3D email updates signup",
      )}&body=${encodeURIComponent("Sign me up: " + email)}`;
    }
  });
</script>

<style>
  .durability-home { --reading-size: var(--t-section); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); border-bottom: 1px solid var(--paper); }
  .hero-copy { min-width: 0; padding: 46px 48px 35px; align-self: center; }
  .hero-copy > .eyebrow { color: var(--body); }
  .hero h1 { margin: 22px 0 24px; font-size: clamp(66px, 6.1vw, 94px); line-height: .91; letter-spacing: -.025em; }
  .hero h1 span { color: var(--signal); }
  .hero-lead { font-family: var(--font-word); font-size: 19px; line-height: 1.5; }
  .hero-body { max-width: 54ch; margin-top: 12px; color: var(--body); font-size: var(--reading-size); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 19px; margin-top: 25px; }
  .hero-actions .btn { min-height: 48px; gap: 20px; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; color: var(--paper); font-family: var(--font-text); font-size: 16px; font-weight: 600; line-height: 1.5; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--rule-3); }
  .text-link:hover { color: var(--ion); text-decoration-color: currentColor; }
  .hero-scope { max-width: 52ch; margin-top: 18px; color: var(--body); font-size: 14px; line-height: 1.55; }
  .bench-board { min-width: 0; display: flex; flex-direction: column; padding: 24px; border-left: 1px solid var(--paper); background: var(--journal-board); color: var(--ink); }
  .board-heading { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 16px; color: var(--inv-body); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .board-heading span:last-child { color: var(--acid); }
  .design-study { position: relative; flex: 1; min-height: 310px; background: var(--ground-deep); }
  .design-study > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 43%; }
  .design-study figcaption { position: absolute; inset: auto 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 14px; background: var(--ground); color: var(--body); font-size: var(--t-micro); }
  .drawing-label { padding: 3px 6px; border: 1px solid var(--rule); color: var(--paper); font-size: var(--t-micro); font-weight: 600; letter-spacing: .08em; }
  .bench-reference { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 21px; padding: 20px 0; }
  .bench-reference img { width: 110px; height: 113px; object-fit: cover; object-position: 30% 12%; border: 5px solid var(--ground); transform: rotate(-3deg); }
  .bench-reference .eyebrow { color: var(--acid); font-size: var(--t-micro); }
  .bench-reference h2 { margin: 9px 0 7px; font-size: 25px; line-height: 1.05; }
  .bench-reference p:not(.eyebrow) { color: var(--inv-body); font-size: var(--t-dense); }
  .study-status { border-top: 1px solid var(--inv-label); padding-top: 14px; font-size: var(--t-dense); line-height: 1.5; }
  .study-status p { color: var(--inv-body); }
  .study-status a { display: inline-block; margin-top: 6px; color: var(--acid); font-family: var(--font-text); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  .plastic-statement { display: grid; grid-template-columns: .9fr 1.1fr; gap: 62px; padding: 40px 48px; background: var(--panel); }
  .plastic-statement h2 { margin-top: 13px; font-size: 34px; line-height: 1; }
  .plastic-statement > div:last-child { max-width: 68ch; align-self: center; color: var(--body); font-size: var(--reading-size); line-height: 1.6; }
  .statement-note { margin-top: 14px; font-size: var(--t-dense); }

  .conditions { padding: 52px 48px 30px; background: var(--journal-charcoal); color: var(--ink); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .section-heading h2 { margin-top: 14px; font-size: clamp(32px, 3.2vw, 44px); line-height: 1; }
  .conditions .eyebrow { color: var(--acid); }
  .section-heading > p { max-width: 43ch; color: var(--inv-body); font-size: var(--t-dense); line-height: 1.6; }
  .condition-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-top: 35px; }
  .condition-card { display: flex; flex-direction: column; padding-top: 19px; border-top: 1px solid var(--inv-label); }
  .condition-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: var(--ion-light); }
  .condition-top span { font-size: var(--t-micro); letter-spacing: .07em; }
  .condition-card h3 { max-width: 18ch; margin: 15px 0; font-size: 28px; line-height: 1.06; }
  .condition-card > p { flex: 1; color: var(--inv-body); font-size: var(--t-dense); line-height: 1.6; }
  .condition-card > a { align-self: flex-start; margin-top: 24px; color: var(--acid); font-family: var(--font-text); font-size: var(--t-dense); font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .conditions-note { margin-top: 35px; padding-top: 20px; border-top: 1px solid var(--rule); color: var(--inv-label); font-size: var(--t-dense); line-height: 1.6; }
  .conditions-note a { display: inline-block; margin-left: 8px; color: var(--inv-body); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  .industry-note { display: grid; grid-template-columns: .5fr 1.5fr .55fr; gap: 32px; padding: 33px 48px; border-bottom: 1px solid var(--rule); background: var(--ground-deep); }
  .industry-note > .eyebrow { color: var(--body); padding-top: 5px; }
  .industry-note h2 { font-size: 25px; line-height: 1.1; margin-bottom: 12px; }
  .industry-note p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .industry-note .industry-boundary { margin-top: 12px; font-size: 14px !important; }
  .industry-note > a { align-self: start; }

  .questions-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; padding: 62px 48px; }
  .questions-section h2 { margin: 15px 0 20px; font-size: 46px; line-height: 1; }
  .questions-section > div:first-child > p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .questions-section .text-link { margin-top: 23px; }

  .field-index { padding: 52px 48px 36px; border-top: 1px solid var(--rule); background: var(--panel); }
  .index-intro { max-width: 76ch; margin-top: 21px; color: var(--body); font-size: var(--t-section); line-height: 1.6; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); margin-top: 30px; align-items: stretch; }
  .index-note { max-width: 96ch; margin-top: 22px; color: var(--body); font-size: 14px; line-height: 1.55; }

  .workshop-section { display: grid; grid-template-columns: 1.1fr .9fr; gap: 70px; padding: 57px 48px; }
  .workshop-copy h2 { margin: 17px 0 24px; font-size: 44px; line-height: 1; }
  .workshop-copy > p:not(.eyebrow):not(.request-note) { max-width: 59ch; color: var(--body); font-size: var(--reading-size); line-height: 1.6; }
  .request-note { margin-top: 18px; font-size: 14px; color: var(--body); }
  .part-paths { border-top: 1px solid var(--rule); }
  .part-paths article { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .part-paths span { color: var(--body); font-size: var(--t-micro); letter-spacing: .1em; }
  .part-paths h3 { margin: 9px 0 11px; font-size: 26px; line-height: 1.1; }
  .part-paths p { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }

  .dispatch { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 55px; padding: 35px 48px; border-top: 1px solid var(--rule); background: var(--ground-deep); }
  .dispatch h2 { margin: 12px 0; font-size: 28px; line-height: 1.1; }
  .dispatch p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .dispatch-form label { display: block; margin-bottom: 8px; font-size: var(--t-micro); color: var(--body); letter-spacing: .1em; }
  .dispatch-fields { display: flex; }
  .dispatch-form input[type="email"] { flex: 1; min-width: 0; min-height: 44px; padding: 11px 13px; border: 1px solid var(--paper); border-right: 0; background: var(--ground); color: var(--paper); font-size: 16px; }
  .dispatch-form input::placeholder { color: var(--body); }
  .dispatch-note { margin-top: 10px; font-size: 13px !important; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }

  @media (min-width: 1500px) { .hero-copy { padding-inline: 6vw; } .bench-board { padding: 32px; } .design-study { min-height: 340px; } }
