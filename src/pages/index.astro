---
import Base from "../layouts/Base.astro";
import RegisterCard from "../components/RegisterCard.astro";
import OfferPaths from "../components/OfferPaths.astro";
import BenchLogs from "../components/BenchLogs.astro";
import { listedParts } from "../lib/catalog";
import { car } from "../data/car.mjs";

const parts = listedParts();
const pick = (state: string) => parts.find((part) => part.state === state && !part.safetyGated);
// Evidence first, then the part in long-term testing, then the custom-design door.
const cards = [pick("fitted") ?? pick("measured") ?? pick("development"), parts.find((part) => part.safetyGated)].filter(Boolean);
const carPhoto = car.photos[0];
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "OCP3D",
  alternateName: "Old Car Problems",
  url: "https://ocp3d.com/",
  logo: "https://ocp3d.com/favicon.svg",
  email: "requests@ocp3d.com",
  description: "3D-printed parts and engineering for old car problems: custom design and prototyping for pre-2000 cars across makes.",
  // The brand's exact reach (BRAND.md): no statewide claim.
  areaServed: ["Lakes Region, New Hampshire", "Seacoast, New Hampshire", "Lakes Region, Maine", "Seacoast, Maine"],
};

const conditions = [
  { n: "01", icon: "heat", title: "A car parked in the sun.", material: "HEAT", body: "ASA handles cabin heat far better than ordinary PLA.", href: "/materials/#material-asa" },
  { n: "02", icon: "sun", title: "Sunlight, day after day.", material: "UV", body: "Some plastics fade and crack in sun. ASA is a strong candidate.", href: "/materials/#material-asa" },
  { n: "03", icon: "load", title: "The thousandth use.", material: "FLEX & WEAR", body: "Clips flex, holders stay rigid. The plastic has to match.", href: "/materials/#compare" },
];
---

<Base
  jsonLd={organization}
  title="OCP3D — Old cars. Modern materials."
  description="Hard-to-find parts. Useful new ideas. Explore OCP3D’s parts in development or discuss custom design and 3D-printing for pre-2000 cars across makes. Based in New Hampshire’s Lakes Region."
  sheet="PARTS · CUSTOM DESIGN"
>
  <div class="durability-home">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">AN INDEPENDENT WORKSHOP / NEW HAMPSHIRE</p>
        <h1 id="home-title">Old cars.<br /><span>Modern<br /> materials.</span></h1>
        <p class="hero-lead">Hard-to-find parts. Useful new ideas.</p>
        <p class="hero-body">I design and 3D-print fixes for old-car problems, across makes and models.</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/custom/">EXPLORE CUSTOM DESIGN <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/registry/">Parts &amp; projects <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-scope">Pre-2000 · Unbranded · Non-safety-critical · No CAD file needed</p>
      </div>

      <aside class="bench-board" aria-label="Genuine founder work, not a customer success story">
        <div class="board-heading"><span>REAL PART. REAL BENCH.</span><span>FOUNDER PROJECT / 001</span></div>
        <figure class="design-study">
          <img src="/images/hero/measured.jpg" alt="Original reference part beside a ruler on the founder’s measurement bench" width="1280" height="960" fetchpriority="high" />
          <figcaption><span class="drawing-label">ORIGINAL PART</span><span>Bench photo, not a printed replacement</span></figcaption>
        </figure>
        <div class="bench-reference">
          <img src={carPhoto.src} alt={carPhoto.alt} width={carPhoto.width} height={carPhoto.height} />
          <div><p class="eyebrow">THE CAR / MY ’83 SUPRA</p><h2>One old car started this.<br /> Not one kind of customer.</h2></div>
        </div>
        <div class="study-status"><p>Visor clip: in the car since Sept 8. Fit record not filed yet.</p><a href="/journal/sun-visor-clip/">Read how it got there <span aria-hidden="true">→</span></a></div>
      </aside>
    </section>

    <OfferPaths />

    <BenchLogs />

    <section class="conditions" aria-labelledby="conditions-title">
      <div class="section-heading"><div><p class="eyebrow">“BUT WILL IT LAST?”</p><h2 id="conditions-title">The job chooses<br />the material.</h2></div><a class="text-link text-link--light" href="/materials/">The plain-English materials guide <span aria-hidden="true">→</span></a></div>
      <div class="condition-grid">
        {conditions.map((condition) => (
          <a class="condition-card" href={condition.href}>
            <div class="condition-top"><span>{condition.n} / {condition.material}</span>
              <svg viewBox="0 0 48 48" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                {condition.icon === "heat" ? <><path d="M20 29V9a4 4 0 0 1 8 0v20a9 9 0 1 1-8 0Z" /><path d="M24 16v19m10-20h6m-6 8h4" /><circle cx="24" cy="36" r="3" /></> : condition.icon === "sun" ? <><circle cx="24" cy="24" r="9" /><path d="M24 2v7m0 30v7M2 24h7m30 0h7M8 8l5 5m22 22 5 5M8 40l5-5m22-22 5-5" /></> : <><path d="M8 18h32v12H8zM16 18v12m8-12v12m8-12v12M24 2v10m-4-4 4 4 4-4M24 46V36m-4 4 4-4 4 4" /></>}
              </svg>
            </div>
            <h3>{condition.title}</h3><p>{condition.body}</p>
          </a>
        ))}
      </div>
      <p class="conditions-note">A material can be capable. A part still has to prove it.</p>
    </section>

    <section class="field-index" aria-labelledby="evidence-title">
      <div class="section-heading"><div><p class="eyebrow">THE EVIDENCE SO FAR</p><h2 id="evidence-title">Where each part stands.</h2></div><a class="text-link" href="/registry/">See parts &amp; projects <span aria-hidden="true">→</span></a></div>
      <p class="index-intro">Founder work so far, all from my Supra. Nothing here is a ready-to-buy range yet.</p>
      <div class="cards">
        {cards.map((part) => <RegisterCard part={part} />)}
        <aside class="your-project" aria-labelledby="your-project-title">
          <p class="eyebrow">YOUR CAR</p>
          <h3 id="your-project-title">Something your car needs?</h3>
          <p>Tell me the car and the problem. Design and prototyping are quoted before they start.</p>
          <a class="text-link" href="/custom/">Explore custom design <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </section>

    <section class="workshop-section" aria-labelledby="workshop-title">
      <div class="workshop-copy"><p class="eyebrow">ONE PERSON’S WORKSHOP / NH’S LAKES REGION</p><h2 id="workshop-title">Start online.<br />Meet where it helps.</h2><p>Tell me about the car and what you want to solve. You’ll talk to the person doing the design.</p><div class="hero-actions"><a class="btn btn--primary" href="/request/">TELL ME ABOUT YOUR PROJECT <span aria-hidden="true">→</span></a><a class="text-link" href="/custom/#working-together">What happens next →</a></div><p class="request-note">Custom work is paid, and quoted before it starts.</p></div>
      <div class="part-paths"><article><span>LOCAL / BY ARRANGEMENT</span><h3>Seacoast &amp; Lakes Region.</h3><p>Visits across the Seacoast and Lakes Region of New Hampshire and Maine, by arrangement.</p></article><article><span>FURTHER AWAY?</span><h3>You don’t need my car.</h3><p>We can work from your original, your car or guided measurements. Ask before posting a part.</p></article></div>
    </section>

    <section class="dispatch" id="register" aria-labelledby="dispatch-title">
      <div><p class="eyebrow">EMAIL UPDATES</p><h2 id="dispatch-title">Follow the parts.</h2><p>An email when a part actually moves forward. Nothing else.</p></div>
      <div class="dispatch-signup">
        <form class="dispatch-form" id="join-form" method="post" action="/api/request">
          <input type="hidden" name="type" value="membership" />
          <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label for="dispatch-email">YOUR EMAIL ADDRESS</label>
          <div class="dispatch-fields"><input id="dispatch-email" type="email" name="email" required placeholder="you@garage.example" /><button class="btn btn--primary" type="submit">GET EMAIL UPDATES →</button></div>
        </form>
        <p class="dispatch-done" id="join-done" role="status" aria-live="polite" hidden></p>
        <p class="dispatch-note">Never sold or used to build a profile.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const joinForm = document.getElementById("join-form") as HTMLFormElement | null;
  const joinDone = document.getElementById("join-done") as HTMLElement | null;
  joinForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(joinForm);
    const email = String(data.get("email") || "");
    try {
      const res = await fetch(joinForm.action, {
        method: "POST",
        headers: { accept: "application/json" },
        body: data,
      });
      const body = await res.json();
      if (!res.ok || !body.ok) throw new Error(String(res.status));
      const num = body?.case ? `№ ${body.case}` : "on file";
      if (joinDone) {
        joinDone.textContent = `You’re on the list (${num}). I’ll write when a part actually moves forward.`;
        joinDone.hidden = false;
      }
      joinForm.hidden = true;
    } catch {
      window.location.href = `mailto:requests@ocp3d.com?subject=${encodeURIComponent(
        "OCP3D email updates signup",
      )}&body=${encodeURIComponent("Sign me up: " + email)}`;
    }
  });
</script>

<style>
  .durability-home { --reading-size: var(--t-section); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); border-bottom: 1px solid var(--paper); }
  .hero-copy { min-width: 0; padding: 46px 48px 35px; align-self: center; }
  .hero-copy > .eyebrow { color: var(--body); }
  .hero h1 { margin: 22px 0 24px; font-size: clamp(66px, 6.1vw, 94px); line-height: .91; letter-spacing: -.025em; }
  .hero h1 span { color: var(--signal); }
  .hero-lead { font-family: var(--font-word); font-size: 19px; line-height: 1.5; }
  .hero-body { max-width: 54ch; margin-top: 12px; color: var(--body); font-size: var(--reading-size); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 19px; margin-top: 25px; }
  .hero-actions .btn { min-height: 48px; gap: 20px; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; color: var(--paper); font-family: var(--font-text); font-size: 16px; font-weight: 600; line-height: 1.5; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--rule-3); }
  .text-link:hover { color: var(--ion); text-decoration-color: currentColor; }
  .hero-scope { max-width: 52ch; margin-top: 18px; color: var(--body); font-size: 14px; line-height: 1.55; }
  .bench-board { min-width: 0; display: flex; flex-direction: column; padding: 24px; border-left: 1px solid var(--paper); background: var(--journal-board); color: var(--ink); }
  .board-heading { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 16px; color: var(--inv-body); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .board-heading span:last-child { color: var(--acid); }
  .design-study { position: relative; flex: 1; min-height: 310px; background: var(--ground-deep); }
  .design-study > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 43%; }
  .design-study figcaption { position: absolute; inset: auto 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 14px; background: var(--ground); color: var(--body); font-size: var(--t-micro); }
  .drawing-label { padding: 3px 6px; border: 1px solid var(--rule); color: var(--paper); font-size: var(--t-micro); font-weight: 600; letter-spacing: .08em; }
  .bench-reference { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 21px; padding: 20px 0; }
  .bench-reference img { width: 150px; height: 100px; object-fit: cover; object-position: 45% 68%; border: 5px solid var(--ground); transform: rotate(-3deg); }
  .bench-reference .eyebrow { color: var(--acid); font-size: var(--t-micro); }
  .bench-reference h2 { margin: 9px 0 7px; font-size: 25px; line-height: 1.05; }
  .bench-reference p:not(.eyebrow) { color: var(--inv-body); font-size: var(--t-dense); }
  .study-status { border-top: 1px solid var(--inv-label); padding-top: 14px; font-size: var(--t-dense); line-height: 1.5; }
  .study-status p { color: var(--inv-body); }
  .study-status a { display: inline-block; margin-top: 6px; color: var(--acid); font-family: var(--font-text); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }


  .conditions { padding: 52px 48px 30px; background: var(--journal-charcoal); color: var(--ink); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .section-heading h2 { margin-top: 14px; font-size: clamp(32px, 3.2vw, 44px); line-height: 1; }
  .conditions .eyebrow { color: var(--acid); }
  .section-heading > p { max-width: 43ch; color: var(--inv-body); font-size: var(--t-dense); line-height: 1.6; }
  .condition-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-top: 35px; }
  .condition-card { display: flex; flex-direction: column; padding-top: 19px; border-top: 1px solid var(--inv-label); color: var(--ink); }
  .condition-card:hover { color: var(--acid); }
  .text-link--light { color: var(--acid); text-decoration-color: var(--inv-label); }
  .text-link--light:hover { color: var(--ink); }
  .condition-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: var(--ion-light); }
  .condition-top span { font-size: var(--t-micro); letter-spacing: .07em; }
  .condition-card h3 { max-width: 18ch; margin: 15px 0; font-size: 28px; line-height: 1.06; }
  .condition-card > p { flex: 1; color: var(--inv-body); font-size: var(--t-dense); line-height: 1.6; }
  .conditions-note { margin-top: 35px; padding-top: 20px; border-top: 1px solid var(--rule); color: var(--inv-label); font-size: var(--t-dense); line-height: 1.6; }



  .field-index { padding: 52px 48px 36px; border-top: 1px solid var(--rule); background: var(--panel); }
  .index-intro { max-width: 76ch; margin-top: 21px; color: var(--body); font-size: var(--t-section); line-height: 1.6; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); margin-top: 30px; align-items: stretch; }
  .your-project { display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 28px 24px; border: 1px solid var(--paper); background: var(--journal-board); color: var(--ink); }
  .your-project .eyebrow { color: var(--acid); }
  .your-project h3 { font-size: 30px; line-height: 1.02; }
  .your-project p:not(.eyebrow) { color: var(--inv-body); font-size: var(--t-dense); line-height: 1.55; }
  .your-project .text-link { color: var(--acid); text-decoration-color: var(--inv-label); }
  .your-project .text-link:hover { color: var(--ink); }

  .workshop-section { display: grid; grid-template-columns: 1.1fr .9fr; gap: 70px; padding: 57px 48px; }
  .workshop-copy h2 { margin: 17px 0 24px; font-size: 44px; line-height: 1; }
  .workshop-copy > p:not(.eyebrow):not(.request-note) { max-width: 59ch; color: var(--body); font-size: var(--reading-size); line-height: 1.6; }
  .request-note { margin-top: 18px; font-size: 14px; color: var(--body); }
  .part-paths { border-top: 1px solid var(--rule); }
  .part-paths article { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .part-paths span { color: var(--body); font-size: var(--t-micro); letter-spacing: .1em; }
  .part-paths h3 { margin: 9px 0 11px; font-size: 26px; line-height: 1.1; }
  .part-paths p { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }

  .dispatch { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 55px; padding: 35px 48px; border-top: 1px solid var(--rule); background: var(--ground-deep); }
  .dispatch h2 { margin: 12px 0; font-size: 28px; line-height: 1.1; }
  .dispatch p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .dispatch-form label { display: block; margin-bottom: 8px; font-size: var(--t-micro); color: var(--body); letter-spacing: .1em; }
  .dispatch-fields { display: flex; }
  .dispatch-form input[type="email"] { flex: 1; min-width: 0; min-height: 44px; padding: 11px 13px; border: 1px solid var(--paper); border-right: 0; background: var(--ground); color: var(--paper); font-size: 16px; }
  .dispatch-form input::placeholder { color: var(--body); }
  .dispatch-note { margin-top: 10px; font-size: 13px !important; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }

  @media (min-width: 1500px) { .hero-copy { padding-inline: 6vw; } .bench-board { padding: 32px; } .design-study { min-height: 340px; } }
  @media (max-width: 1050px) { .hero-copy { padding: 36px 30px; } .hero h1 { font-size: clamp(54px, 6.5vw, 70px); } .hero-lead { font-size: 17px; } .hero-actions { gap: 15px; } .bench-board { padding: 20px; } .bench-reference { grid-template-columns: 120px 1fr; gap: 15px; } .bench-reference img { width: 120px; height: 84px; } .bench-reference h2 { font-size: 24px; } .conditions, .field-index, .workshop-section, .dispatch { padding-inline: 30px; } .workshop-section { gap: 34px; } .condition-grid { gap: 22px; } }
  @media (max-width: 800px) { .hero { grid-template-columns: 1fr; } .hero-copy { padding: 42px 32px; } .hero h1 { font-size: 82px; } .hero h1 span br { display: none; } .hero-body { max-width: 65ch; } .bench-board { border-left: 0; border-top: 1px solid var(--paper); padding: 24px; } .design-study { min-height: 360px; } .bench-reference { grid-template-columns: 130px 1fr; } .bench-reference img { width: 130px; height: 90px; } .bench-reference h2 br { display: none; } .condition-grid { grid-template-columns: 1fr; gap: 28px; } .condition-card { display: grid; grid-template-columns: 1fr 1.2fr; gap: 0 30px; } .condition-top { grid-column: 1; } .condition-top svg { width: 35px; height: 35px; } .condition-card h3 { grid-column: 1; } .condition-card > p { grid-column: 2; grid-row: 1 / 3; } .section-heading { flex-direction: column; align-items: flex-start; gap: 18px; } .cards { grid-template-columns: 1fr; } .workshop-section, .dispatch { grid-template-columns: 1fr; gap: 30px; } }
  @media (max-width: 540px) { .hero-copy { padding: 33px 22px 30px; } .hero h1 { font-size: clamp(50px, 15vw, 78px); margin-top: 21px; } .hero h1 span br { display: block; } .hero-copy > .eyebrow { max-width: 35ch; font-size: var(--t-micro); line-height: 1.6; } .hero-lead { font-size: 18px; } .hero-actions { gap: 18px; } .hero-actions .btn { font-size: var(--t-micro); } .hero-scope { font-size: 14px; } .bench-board { padding: 18px; } .board-heading { font-size: var(--t-micro); } .design-study { min-height: 300px; } .design-study figcaption { font-size: var(--t-micro); gap: 6px; padding: 9px; } .bench-reference { gap: 15px; } .bench-reference h2 { font-size: 23px; } .bench-reference h2 br { display: block; } .bench-reference .eyebrow { font-size: var(--t-micro); } .bench-reference p:not(.eyebrow) { font-size: 14px; } .conditions, .field-index, .workshop-section, .dispatch { padding: 34px 22px; } .condition-card { display: flex; } .condition-card h3 { max-width: 20ch; } .condition-top svg { width: 42px; height: 42px; } .condition-card > p { font-size: var(--t-dense); } .section-heading h2, .workshop-copy h2 { font-size: 34px; } .index-intro { font-size: var(--t-dense); } .dispatch-fields { flex-direction: column; gap: 8px; } .dispatch-form input[type="email"] { border-right: 1px solid var(--paper); } .dispatch-fields .btn { min-height: 44px; } }
</style>
