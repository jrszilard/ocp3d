---
import Base from "../layouts/Base.astro";
import parts from "../data/parts.json";
import RegisterCard from "../components/RegisterCard.astro";

/* A founder's real A60 problem becomes a field file. The public offer must
   stay behind the evidence carried by each record—especially the fitted-only
   made-to-order invitation on individual part pages. */
const pick = (state: string) => parts.find((p: any) => p.state === state && !p.safetyGated);
const wiperResearch = parts.find((p: any) => p.safetyGated);
const cards = [wiperResearch, pick("measured"), pick("requested")].filter(Boolean);
const visor: any = parts.find((p: any) => p.slug === "sun-visor-clip");
const dimsOnRecord = visor?.dimsConfirmed ?? 0;

const legs = [
  ["01", "Start with the problem.", "A broken original, an empty mounting point, or a daily annoyance is enough to open a field file."],
  ["02", "Trace the useful leads.", "A part number, manual, donor photo, and owner knowledge can show what deserves investigation next."],
  ["03", "Return to the interface.", "Photos establish that a feature exists. The physical part or mounting space establishes the dimensions."],
  ["04", "Earn the record.", "Fit and function each earn their own line. A route, render, or story never proves either one."],
];

const paths = [
  {
    name: "RESTORE",
    kicker: "A faithful part path",
    title: "Keep a useful original in service.",
    body: "A surviving original, donor, or measured mating surface can become a documented replacement or repair aid. The record states what belongs to the original and what still needs proof.",
    facts: ["ORIGINAL / INTERFACE", "MEASURED DIMENSIONS", "REAL-CAR FIT RECORD"],
  },
  {
    name: "IMPROVE",
    kicker: "An OCP3D-original part path",
    title: "Solve what the old car never did.",
    body: "A reversible console cup holder is not a factory replacement. It is an OCP3D-original convenience idea that must earn its own measured interface, clearance, retention, material, and functional record.",
    facts: ["MEASURED MOUNTING SPACE", "CLEARANCE / RETENTION", "FUNCTIONAL RECORD"],
  },
];
---

<Base
  title="OCP3D — Old-car problems, traced back to a useful part."
  description="OCP3D investigates missing parts and useful old-car improvements from a real interface, then keeps the evidence on record."
  sheet="PARTS INVESTIGATION · A60 / 01"
>
  <section class="hero">
    <aside class="evidence-board" aria-label="OCP3D parts investigation board">
      <div class="board-head"><span><b>CASE A60 / 001</b><br />PARTS TRAIL OPEN</span><span>Every lead returns to the physical part.</span></div>
      <svg class="route-map" viewBox="0 0 620 430" role="img" aria-label="Abstract route line connecting a problem to an investigated interface">
        <defs><pattern id="map-grid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#b6c7b6" stroke-opacity=".25" stroke-width="1"/></pattern></defs>
        <rect width="620" height="430" fill="url(#map-grid)" />
        <path d="M20 324 C105 286, 115 135, 236 157 S339 282, 401 215 S521 59, 598 83" fill="none" stroke="#e6b65f" stroke-width="2" stroke-dasharray="8 8" />
        <path d="M20 342 C106 305, 119 153, 236 175 S341 300, 415 233 S526 77, 600 101" fill="none" stroke="#58beb1" stroke-width="1" opacity=".9" />
        <circle cx="25" cy="328" r="7" fill="#c9533d"/><circle cx="235" cy="157" r="7" fill="#e6b65f"/><circle cx="404" cy="215" r="7" fill="#58beb1"/><circle cx="598" cy="83" r="7" fill="#c9533d"/>
        <text x="35" y="360" fill="#dbe0d1">PROBLEM</text><text x="183" y="138" fill="#dbe0d1">INTERFACE</text><text x="365" y="245" fill="#dbe0d1">DESIGN LEAD</text><text x="514" y="66" fill="#dbe0d1">BENCH PROOF</text>
        <path d="M45 89H201M418 345H574" stroke="#b6c7b6" stroke-opacity=".5" stroke-width="1"/><text x="47" y="81" fill="#e6b65f">TWO PATHS / ONE TEST</text><text x="420" y="337" fill="#e6b65f">RETURN TO PROOF</text>
      </svg>
      <figure class="evidence-photo photo-original">
        <img src="/images/process/original.jpg" alt="An original OCP3D part on the measurement bench" width="1280" height="960" />
        <figcaption>LEAD 01 / ORIGINAL IN HAND</figcaption>
      </figure>
      <figure class="evidence-photo photo-measure">
        <img src="/images/process/measurement.jpg" alt="A caliper and OCP3D part on the measurement bench" width="1280" height="960" />
        <figcaption>LEAD 03 / MEASURE WHAT REMAINS</figcaption>
      </figure>
      <i class="pin pin-one" aria-hidden="true"></i><i class="pin pin-two" aria-hidden="true"></i><i class="pin pin-three" aria-hidden="true"></i>
      <div class="improvement-card"><span>NEW CASE TYPE</span><b>OWNER IMPROVEMENT</b><i>CUP HOLDER / START WITH CONSOLE</i></div>
      <div class="roadbook"><b>ROADBOOK / 01</b><span class="road-arrow" aria-hidden="true"></span><i>MISSING PART OR USEFUL ADDITION → INTERFACE → BENCH EVIDENCE</i></div>
    </aside>

    <div class="hero-copy">
      <span class="case-stamp"><span>CASE<br />OPEN<br />RETURN<br />TO BENCH</span></span>
      <p class="projection">THE PARTS INVESTIGATION / OPENING ENTRY</p>
      <h1>An old-car problem leaves a trail.</h1>
      <p class="lead">Sometimes that trail begins with a broken original. Sometimes it begins with something the car never had—like a cup holder that respects the console it lives in. Either way, the claim only comes home when the physical interface is on the bench.</p>
      <p class="hero-actions">
        <a class="btn btn--primary" href="/registry/">FOLLOW THE FIELD FILES</a>
        <a class="btn btn--secondary" href="/request/">BRING A LEAD / DISCUSS A PART</a>
      </p>
      <aside class="hero-note">“The route is not the story. The evidence is.”<small>OCP3D FIELD RULE / 01</small></aside>
    </div>
  </section>

  <section class="trail" aria-label="The OCP3D parts investigation process">
    {legs.map(([n, title, body]) => (
      <article><span>LEG {n}</span><h2>{title}</h2><p>{body}</p></article>
    ))}
  </section>

  <section class="path-section">
    <div class="path-intro">
      <div><p class="eyebrow">TWO PART PATHS</p><h2>Restore what is gone. Improve what was never there.</h2></div>
      <p class="lead">The catalog should not pretend these are the same kind of part. They do share one rule: a useful claim needs a measured interface and evidence that matches the claim.</p>
    </div>
    <div class="path-cards">
      {paths.map((path) => (
        <article class:list={["path-card", path.name === "IMPROVE" && "path-card--improve"]}>
          <p class="path-name">{path.name}</p>
          <p class="eyebrow">{path.kicker}</p>
          <h3>{path.title}</h3>
          <p>{path.body}</p>
          <ul>{path.facts.map((fact) => <li>{fact}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="path-cta">
      <div><p class="eyebrow">HAVE A CASE TO OPEN?</p><p>Bring the car, the problem, and whatever remains. I will first look for the honest path: existing supply, a usable donor, a measured interface, or a reason not to make it.</p></div>
      <a class="btn btn--primary" href="/request/">OPEN A PART DISCUSSION</a>
    </div>
  </section>

  <section class="field-index">
    <div class="index-head">
      <div><p class="eyebrow">CURRENT FIELD INDEX</p><h2>What is already on the record.</h2></div>
      <a class="index-link" href="/registry/">SEE ALL {parts.length} FIELD FILES →</a>
    </div>
    <div class="cards">
      {cards.map((p: any, i: number) => <RegisterCard part={p} sheet={i + 1} total={parts.length} />)}
    </div>
    <p class="index-note">These early files are restoration investigations. The wiper-adaptor file is deliberately different: it stays research-only until final vibration, UV-exposure, and rain-functionality testing is complete. Any future OCP3D-original improvement must also carry its own purpose, interface, and functional evidence rather than borrowing a replacement part’s identity.</p>
  </section>

  <section class="proof-section">
    <div class="proof-copy">
      <p class="eyebrow">THE OPERATING LIMIT</p>
      <h2>Evidence before an offer.</h2>
      <p>OCP3D works on pre-2000, unbranded, non-safety-critical parts. The exterior wiper-adaptor record remains research-only while final vibration, UV, and rain testing are pending. A render is not a fit, a photo is not a dimension, and a useful idea is not a product until its own record supports the claim.</p>
      <a href="/method/">READ THE METHOD →</a>
    </div>
    <div class="proof-facts">
      <div><b>0</b><span>STOCK PHOTOS</span></div>
      <div><b>0</b><span>GUESSWORK CLAIMS</span></div>
      <div><b>{dimsOnRecord}</b><span>DIMS ON FIRST FIELD FILE</span></div>
      <div><b>2</b><span>PART PATHS / ONE STANDARD</span></div>
    </div>
  </section>

  <section class="dispatch" id="register">
    <div class="dispatch-copy">
      <p class="eyebrow">OCP3D DISPATCH — NO CHARGE</p>
      <h2>Follow the investigation as the record grows.</h2>
      <p class="lead">A quiet update when a part moves from request to bench, from bench to fit record, or becomes responsibly available. No feed, no membership gate, no noise.</p>
      <form class="dispatch-form" id="join-form" method="post" action="/api/request">
        <input type="hidden" name="type" value="membership" />
        <input type="text" name="company" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="email" name="email" required placeholder="you@garage.example" aria-label="Email address" />
        <button class="btn btn--primary" type="submit">GET THE DISPATCH</button>
      </form>
      <p class="dispatch-done dense" id="join-done" hidden></p>
      <p class="dense dispatch-note">Your address is for the Dispatch only—never sold, shared, or used to build a profile.</p>
    </div>

    <aside class="dispatch-file">
      <div class="dispatch-file-head"><span>FIELD FILE · DISPATCH RECORD</span><span>A60 / FIRST BENCH</span></div>
      <dl>
        <div><dt>STARTING CAR</dt><dd>1983 CELICA SUPRA</dd></div>
        <div><dt>CHANNEL</dt><dd>OCP3D DISPATCH</dd></div>
        <div><dt>ON RECORD</dt><dd>{dimsOnRecord} CONFIRMED DIMENSIONS</dd></div>
        <div><dt>NEXT INPUT</dt><dd>YOUR PART PROBLEM</dd></div>
      </dl>
      <p>“Measure it. Make it useful. Leave the record behind.”</p>
    </aside>
  </section>
</Base>

<script>
  const joinForm = document.getElementById("join-form") as HTMLFormElement | null;
  const joinDone = document.getElementById("join-done") as HTMLElement | null;
  joinForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(joinForm);
    const email = String(data.get("email") || "");
    try {
      const res = await fetch(joinForm.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      if (!res.ok) throw new Error(String(res.status));
      const body = await res.json().catch(() => ({} as any));
      const num = body?.case ? `№ ${body.case}` : "on file";
      if (joinDone) {
        joinDone.textContent = `Dispatch file ${num} — I will write when a part actually moves forward.`;
        joinDone.hidden = false;
      }
      joinForm.hidden = true;
    } catch {
      window.location.href = `mailto:requests@lostclipsociety.com?subject=${encodeURIComponent(
        "OCP3D Dispatch signup",
      )}&body=${encodeURIComponent("Sign me up: " + email)}`;
    }
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: 48% 52%; min-height: 590px; border-bottom: 2px solid var(--paper); }
  .evidence-board { position: relative; overflow: hidden; min-height: 590px; border-right: 2px solid var(--paper); background: linear-gradient(150deg, var(--journal-board), var(--journal-charcoal)); }
  .evidence-board::before { content: ""; position: absolute; inset: 0; opacity: .19; background-image: radial-gradient(circle at 1px 1px, #d9d4bd 1px, transparent 1.4px); background-size: 14px 14px; }
  .board-head { position: absolute; z-index: 4; top: 22px; right: 24px; left: 24px; display: flex; justify-content: space-between; gap: 12px; color: var(--inv-body); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; }
  .board-head b { color: var(--acid); font-weight: 600; }.board-head span:last-child { max-width: 145px; color: var(--inv-label); text-align: right; }
  .route-map { position: absolute; inset: 44px 15px 106px; width: calc(100% - 30px); height: calc(100% - 150px); z-index: 0; }.route-map text { font-family: var(--font-mono); font-size: 8px; letter-spacing: 1px; }
  .evidence-photo { position: absolute; z-index: 2; margin: 0; padding: 9px 9px 29px; background: var(--ground); box-shadow: 8px 10px 0 rgba(0,0,0,.26); }.evidence-photo::before { content: ""; position: absolute; top: -10px; left: 50%; width: 88px; height: 23px; background: rgba(211,177,109,.78); transform: translateX(-50%) rotate(-4deg); }
  .evidence-photo img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.04) saturate(.84); }.evidence-photo figcaption { position: absolute; bottom: 9px; left: 10px; color: #55544c; font-size: 7px; letter-spacing: .08em; text-transform: uppercase; }
  .photo-original { top: 104px; left: 14%; width: 45%; height: 284px; transform: rotate(-3.5deg); }.photo-original img { object-position: 50% 43%; }.photo-measure { top: 222px; right: 8%; width: 38%; height: 223px; transform: rotate(4deg); }.photo-measure::before { width: 73px; background: rgba(94,150,145,.78); transform: translateX(-50%) rotate(4deg); }.photo-measure img { object-position: 44% 53%; }
  .pin { position: absolute; z-index: 5; width: 13px; height: 13px; border: 2px solid #f8e8b6; border-radius: 50%; box-shadow: 0 1px 3px rgba(0,0,0,.55); }.pin-one { top: 144px; left: 10.5%; background: var(--signal); }.pin-two { top: 205px; right: 10%; background: var(--acid); }.pin-three { bottom: 150px; left: 23%; background: var(--ion-light); }
  .improvement-card { position: absolute; z-index: 3; top: 72px; right: 25px; width: 164px; padding: 10px 11px; border: 1px solid #f5dd9d; background: var(--acid); color: #26363a; box-shadow: 4px 5px 0 rgba(0,0,0,.2); font-size: 7px; line-height: 1.48; letter-spacing: .08em; text-transform: uppercase; transform: rotate(2deg); }.improvement-card span { display: block; color: #aa4737; }.improvement-card b { display: block; margin: 5px 0; font-weight: 600; font-size: 9px; line-height: 1.18; }.improvement-card i { color: #4d5e59; font-style: normal; }
  .roadbook { position: absolute; z-index: 4; right: 22px; bottom: 22px; left: 22px; display: grid; grid-template-columns: 94px 1fr auto; align-items: center; gap: 12px; padding: 12px 14px; border-top: 2px solid var(--acid); background: #f0e2bb; color: #253238; box-shadow: 5px 6px 0 rgba(0,0,0,.22); font-size: 8px; line-height: 1.45; letter-spacing: .07em; text-transform: uppercase; }.roadbook b { color: #b94636; font-weight: 600; }.road-arrow { position: relative; width: 40px; height: 22px; border-top: 3px solid #2f7976; }.road-arrow::after { content: ""; position: absolute; top: -7px; right: 0; width: 12px; height: 12px; border-top: 3px solid #2f7976; border-right: 3px solid #2f7976; transform: rotate(45deg); }.roadbook i { color: #68706c; font-style: normal; }

  .hero-copy { position: relative; padding: var(--sec-hero); overflow: hidden; background: repeating-linear-gradient(0deg, transparent 0 31px, rgba(65,82,76,.14) 31px 32px), var(--ground); }.hero-copy::after { content: ""; position: absolute; right: -42px; bottom: -74px; width: 260px; height: 260px; border: 1px solid rgba(48,94,89,.24); border-radius: 50%; box-shadow: 0 0 0 24px rgba(48,94,89,.08), 0 0 0 48px rgba(48,94,89,.05); }
  .projection { position: relative; z-index: 2; color: var(--signal); font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; }.hero h1 { position: relative; z-index: 2; max-width: 10ch; margin: 15px 0 20px; }.hero .lead { position: relative; z-index: 2; max-width: 49ch; }.hero-actions { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .case-stamp { position: absolute; z-index: 3; top: 39px; right: 42px; width: 97px; height: 97px; display: grid; place-items: center; border: 2px solid rgba(174,66,49,.8); border-radius: 50%; color: #a54336; font-size: 8px; font-weight: 600; line-height: 1.45; letter-spacing: .1em; text-align: center; text-transform: uppercase; transform: rotate(10deg); }.case-stamp::before { content: ""; position: absolute; inset: 5px; border: 1px dashed currentColor; border-radius: 50%; }.case-stamp span { position: relative; z-index: 1; }
  .hero-note { position: absolute; z-index: 3; right: 42px; bottom: 31px; max-width: 244px; padding: 11px 12px; border-left: 4px solid var(--ion); background: rgba(239,227,200,.92); color: #4c5652; font: italic 15px/1.35 Georgia, serif; }.hero-note small { display: block; margin-top: 5px; color: #6d726d; font: 400 7px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }

  .trail { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 2px solid var(--paper); background: var(--ground); }.trail article { min-height: 154px; padding: 20px; border-left: 1px solid var(--rule); }.trail article:first-child { border-left: 0; }.trail span { color: var(--signal); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }.trail h2 { margin: 11px 0 8px; font-size: 22px; }.trail p { color: var(--body); font-size: var(--t-dense); line-height: var(--t-dense-lh); }

  .path-section { padding: var(--sec-state); background: var(--panel); }.path-intro { display: grid; grid-template-columns: minmax(0, .9fr) minmax(280px, .7fr); gap: 34px; align-items: end; padding-bottom: 26px; }.path-intro h2 { max-width: 14ch; margin-top: 11px; }.path-intro .lead { max-width: 48ch; }
  .path-cards { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--rule-2); }.path-card { padding: 26px 28px; background: var(--ground); }.path-card--improve { border-left: 1px solid var(--rule-2); background: var(--ground-deep); }.path-name { margin-bottom: 18px; color: var(--signal); font-family: var(--font-display); font-size: 36px; line-height: .85; }.path-card h3 { max-width: 15ch; margin: 10px 0 13px; font-size: 27px; }.path-card > p:not(.path-name):not(.eyebrow) { max-width: 55ch; color: var(--body); font-size: var(--t-dense); line-height: var(--t-dense-lh); }.path-card ul { display: grid; gap: 6px; margin-top: 21px; padding-top: 15px; border-top: 1px solid var(--rule-3); }.path-card li { color: var(--ion); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }
  .path-cta { display: flex; align-items: center; justify-content: space-between; gap: 25px; margin-top: 18px; padding: 21px 23px; border: 1px solid var(--rule); background: #e4d5ba; }.path-cta p:not(.eyebrow) { max-width: 68ch; margin-top: 7px; color: var(--body); font-size: var(--t-dense); line-height: var(--t-dense-lh); }

  .field-index { padding: var(--sec-state); }.index-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }.index-head h2 { margin-top: 10px; }.index-link { color: var(--ion); font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-align: right; }.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-cards); margin-top: 23px; }.index-note { max-width: 80ch; margin-top: 18px; color: var(--steel); font-size: var(--t-dense); line-height: var(--t-dense-lh); }

  .proof-section { display: grid; grid-template-columns: 1fr 390px; gap: 42px; padding: var(--sec-state); border-top: 2px solid var(--paper); background: var(--journal-charcoal); color: var(--ink); }.proof-copy .eyebrow { color: var(--acid); }.proof-copy h2 { margin: 11px 0 16px; }.proof-copy p:not(.eyebrow) { max-width: 61ch; color: var(--inv-body); font-size: var(--t-section); line-height: var(--t-section-lh); }.proof-copy a { display: inline-block; margin-top: 17px; color: var(--acid); font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); }.proof-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 23px; align-content: start; }.proof-facts div { display: flex; flex-direction: column; gap: 5px; }.proof-facts b { color: var(--ink); font-family: var(--font-display); font-size: var(--h-fact); line-height: 1; }.proof-facts span { color: var(--inv-label); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }

  .dispatch { display: grid; grid-template-columns: 1fr 420px; gap: 40px; padding: var(--sec-state); background: var(--ground); }.dispatch h2 { max-width: 14ch; margin: 11px 0 16px; }.dispatch-copy .lead { max-width: 58ch; }.dispatch-form { display: flex; max-width: 540px; margin: 27px 0 12px; }.dispatch-form input[type="email"] { flex: 1; min-width: 0; padding: 11px 13px; border: 1px solid var(--paper); border-right: 0; background: var(--ground-deep); color: var(--paper); font-size: var(--t-dense); }.dispatch-form input::placeholder { color: var(--steel); }.hp { position: absolute; left: -9999px; width: 1px; height: 1px; }.dispatch-note { max-width: 520px; color: var(--steel); }.dispatch-done { color: var(--ion); }
  .dispatch-file { align-self: start; border: 1px solid var(--rule-2); background: var(--panel); }.dispatch-file-head { display: flex; justify-content: space-between; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--rule); color: var(--signal); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); }.dispatch-file dl { margin: 0; }.dispatch-file dl > div { display: flex; justify-content: space-between; gap: 15px; padding: 12px 14px; border-top: 1px solid var(--rule-3); }.dispatch-file dl > div:first-child { border-top: 0; }.dispatch-file dt, .dispatch-file dd { margin: 0; font-size: var(--t-micro); letter-spacing: .08em; }.dispatch-file dt { color: var(--steel); }.dispatch-file dd { color: var(--paper); text-align: right; }.dispatch-file > p { margin: 0; padding: 15px 14px; border-top: 1px solid var(--rule); color: var(--steel); font: italic 14px/1.35 Georgia, serif; }

