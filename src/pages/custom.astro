---
import Base from "../layouts/Base.astro";
import ServiceHeading from "../components/ServiceHeading.astro";
import ProjectQuestions from "../components/ProjectQuestions.astro";

const ideas = [
  { n: "01", label: "SOMETHING MISSING", title: "A small part. A big nuisance.", body: "A broken interior piece or unavailable trim finisher. Start with a surviving original—or work out how to measure what remains.", link: "Discuss a missing part", situation: "gone" },
  { n: "02", label: "SOMETHING MORE USEFUL", title: "An idea the car never had.", body: "A small storage insert or another practical interior addition. An original design for your needs, not a pretend OEM replacement.", link: "Discuss an improvement", situation: "improvement" },
  { n: "03", label: "SOMETHING TO ADAPT", title: "A useful idea. Your car.", body: "Explore whether an existing approach can suit your space. Reusing design knowledge can save effort; fit and function still need their own checks.", link: "Discuss an adaptation", situation: "on-car" },
];
const steps = [
  { n: "01", title: "Tell me the problem.", body: "The car, what you want to solve, and what you have access to. We first look at scope, existing alternatives and whether there is a sensible route forward." },
  { n: "02", title: "Agree the work and cost.", body: "A clear scope, required inputs, prototype allowance, checks and proposed timing. If uncertainty calls for a separate paid feasibility stage, we agree that first." },
  { n: "03", title: "Develop. Check. Decide.", body: "Measure the actual interface, develop and evaluate prototypes, then decide the next step. A finished part is only offered when the evidence supports that configuration and material." },
];
---
<Base title="Custom Parts & Design for Old Cars — OCP3D" description="Bring an old-car problem, not a CAD file. Paid design and prototyping for small pre-2000, non-safety-critical parts across makes. Based in NH’s Lakes Region; visits by arrangement." sheet="CUSTOM DESIGN · START WITH THE PROBLEM">
  <div class="custom-page wrap">
    <ServiceHeading eyebrow="CUSTOM DESIGN & PROTOTYPING / ACROSS MAKES" title="Bring the problem. Not a CAD file." lede="A missing piece, a broken original, or a useful addition the car never had. Let’s work out whether a carefully designed 3D-printed part is a sensible answer." audience="owner" file="YOUR CAR. YOUR PROBLEM.">
      <div slot="actions" class="intro-actions"><a class="btn btn--primary" href="/request/">TELL ME WHAT YOU NEED <span aria-hidden="true">→</span></a><a class="underlink" href="#working-together">How we work together ↓</a></div>
    </ServiceHeading>

    <section class="project-ideas" aria-labelledby="ideas-title">
      <div class="section-intro"><div><p class="eyebrow">SMALL PROBLEMS WORTH SOLVING</p><h2 id="ideas-title">What could we work on?</h2></div><p>Examples to discuss—not ready-made products. Each idea needs its own scope, interface and material checks.</p></div>
      <div class="idea-grid">
        {ideas.map((idea) => <article class="idea-card"><div class="idea-top"><span class="idea-number">{idea.n}</span><span>{idea.label}</span></div><h3>{idea.title}</h3><p>{idea.body}</p><a class="underlink" href={`/request/?situation=${idea.situation}`}>{idea.link} <span aria-hidden="true">↗</span></a></article>)}
      </div>
      <p class="scope-line">Pre-2000 · Unbranded · Non-safety-critical. No brakes, steering, structural or other safety-critical parts.</p>
    </section>

    <section class="working-together" id="working-together" aria-labelledby="working-title">
      <div class="working-copy"><p class="eyebrow">A CONVERSATION. A PLAN. THEN THE WORK.</p><h2 id="working-title">Know what you’re<br />getting into.</h2><p>You’ll speak directly to the person doing the design. No technical brief required, no automatic quote, and no promise to print something that isn’t suitable.</p><a class="underlink" href="/method/">A closer look at the development process ↗</a></div>
      <ol class="project-steps">{steps.map((step) => <li><span>{step.n}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol>
    </section>

    <aside class="quote-note" aria-labelledby="quote-title"><div><p class="eyebrow">CUSTOM DOESN’T MEAN OPEN-ENDED</p><h2 id="quote-title">A clear scope.<br />Then a quote.</h2></div><div><p>Custom design and prototyping are <strong>paid work</strong>. The quote identifies development, prototypes and required checks, with manufacturing costs shown separately.</p><p>We agree the stages, included refinements, change and stop terms before work starts. A prototype is for learning—not a guarantee of a finished vehicle part. Sending an enquiry doesn’t order or pay for anything.</p></div></aside>

    <section class="practicalities" aria-label="Materials and access">
      <article><p class="eyebrow">BUILT AROUND THE JOB</p><h2>The right plastic.<br />Not just any plastic.</h2><p>A hot cabin, sunlight, a repeated flex: different jobs ask different things of a material. Design, print direction and actual testing matter too. You don’t need to choose a filament before talking to me.</p><a class="underlink" href="/materials/">Materials &amp; durability, in plain English ↗</a></article>
      <article><p class="eyebrow">BASED IN NH’S LAKES REGION</p><h2>Start online.<br />Meet by arrangement.</h2><p>Visits around Rochester, NH, and selected Maine locations can help with measurement and fit checks. For projects farther away, we first establish a practical way to access the original or mounting interface.</p><p class="small-note">Photos start a conversation; they don’t replace mating dimensions. Please get in touch before sending a part.</p></article>
    </section>

    <section class="project-faq" aria-labelledby="faq-title"><div><p class="eyebrow">BEFORE YOU ASK</p><h2 id="faq-title">Fair questions.<br />Straight answers.</h2><p>No mystery around what you need to bring, what costs money, or what this workshop can take on.</p></div><ProjectQuestions /></section>

    <section class="custom-cta" aria-labelledby="custom-cta-title"><div><p class="eyebrow">KEEP THE CAR. SOLVE THE SMALL THINGS.</p><h2 id="custom-cta-title">What does your old car need?</h2><p>Start with the car and the problem. We’ll discuss the useful next step.</p></div><a class="btn btn--primary" href="/request/">START AN ENQUIRY <span aria-hidden="true">→</span></a></section>
    <p class="existing-link">Looking for something already on the bench? <a class="underlink" href="/registry/">Explore parts &amp; projects →</a></p>
  </div>
</Base>
<style>
  .custom-page { display: grid; gap: 0; }
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 25px; }
  .intro-actions .btn, .custom-cta .btn { min-height: 48px; gap: 22px; }
  .underlink { display: inline-block; color: var(--ion); font-family: var(--font-text); font-size: 16px; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; line-height: 1.8; }
  .underlink:hover { color: var(--paper); }
  .section-intro { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 26px; }
  .section-intro h2 { margin-top: 13px; font-size: 36px; line-height: 1.03; }
  .section-intro > p { max-width: 42ch; color: var(--body); font-size: var(--t-dense); line-height: 1.55; }
  .project-ideas { padding-top: 48px; }
  .idea-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--rule); }
  .idea-card { display: flex; flex-direction: column; padding: 25px; background: var(--panel); }
  .idea-card + .idea-card { border-left: 1px solid var(--rule); }
  .idea-top { display: flex; align-items: center; gap: 13px; color: var(--ion); font-size: var(--t-micro); letter-spacing: .08em; }
  .idea-number { font-family: var(--font-display); font-size: 38px; line-height: 1; color: var(--signal); }
  .idea-card h3 { margin: 24px 0 16px; font-size: 29px; line-height: 1.05; }
  .idea-card > p { flex: 1; color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .idea-card .underlink { margin-top: 25px; }
  .scope-line { padding: 15px 0; color: var(--body); font-size: 14px; line-height: 1.55; }
  .working-together { display: grid; grid-template-columns: .85fr 1.15fr; gap: 50px; padding: 44px 0; margin-top: 28px; border-top: 1px solid var(--rule); scroll-margin-top: 20px; }
  .working-copy h2 { font-size: 40px; margin: 16px 0 22px; line-height: 1.03; }
  .working-copy > p:not(.eyebrow) { color: var(--body); font-size: var(--t-section); line-height: 1.6; }
  .working-copy .underlink { margin-top: 24px; }
  .project-steps li { display: grid; grid-template-columns: 34px 1fr; gap: 20px; padding: 22px 0; border-top: 1px solid var(--rule); }
  .project-steps li:first-child { padding-top: 0; border-top: 0; }
  .project-steps li > span { color: var(--signal); font-size: var(--t-eyebrow); padding-top: 3px; }
  .project-steps h3 { font-size: 26px; line-height: 1.1; margin-bottom: 12px; }
  .project-steps p { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .quote-note { display: grid; grid-template-columns: .8fr 1.2fr; gap: 35px; padding: 34px; background: var(--journal-board); color: var(--ink); }
  .quote-note .eyebrow { color: var(--ion-light); }
  .quote-note h2 { margin-top: 15px; font-size: 36px; line-height: 1.04; }
  .quote-note > div:last-child { color: var(--inv-body); font-size: var(--t-dense); line-height: 1.6; }
  .quote-note p + p { margin-top: 15px; }
  .quote-note strong { color: var(--acid); }
  .practicalities { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; padding: 46px 0; }
  .practicalities h2 { margin: 16px 0 20px; font-size: 33px; line-height: 1.06; }
  .practicalities p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .practicalities .underlink, .practicalities .small-note { margin-top: 18px; }
  .practicalities .small-note { font-size: 14px !important; }
  .project-faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 50px; padding: 44px 0; border-top: 1px solid var(--rule); }
  .project-faq h2 { font-size: 36px; line-height: 1.04; margin: 16px 0 20px; }
  .project-faq > div > p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); line-height: 1.6; }
  .custom-cta { display: flex; justify-content: space-between; align-items: center; gap: 28px; padding: 30px; border: 1px solid var(--rule); background: var(--panel); }
  .custom-cta h2 { font-size: 32px; margin: 14px 0; line-height: 1.06; }
  .custom-cta p:not(.eyebrow) { color: var(--body); font-size: var(--t-dense); }
  .custom-cta .btn { flex: none; }
  .existing-link { text-align: center; padding-top: 24px; font-family: var(--font-text); font-size: var(--t-dense); color: var(--body); }
  @media (max-width: 900px) { .idea-card { padding: 20px; } .idea-top { align-items: flex-start; flex-direction: column; } .working-together, .practicalities, .project-faq { gap: 30px; } .quote-note { padding: 28px; } }
  @media (max-width: 720px) { .section-intro { align-items: flex-start; flex-direction: column; gap: 16px; } .idea-grid, .working-together, .quote-note, .practicalities, .project-faq { grid-template-columns: 1fr; } .idea-card + .idea-card { border-left: 0; border-top: 1px solid var(--rule); } .idea-top { flex-direction: row; align-items: center; } .idea-card h3 { margin-top: 18px; } .custom-cta { flex-direction: column; align-items: flex-start; } .project-faq h2 br { display: none; } .working-copy h2 { font-size: 35px; } }
  @media (max-width: 420px) { .quote-note, .custom-cta { padding: 23px; } .section-intro h2, .project-faq h2 { font-size: 31px; } .intro-actions { gap: 15px; } }
</style>
