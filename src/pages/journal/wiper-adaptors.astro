---
import Base from "../../layouts/Base.astro";
import ServiceHeading from "../../components/ServiceHeading.astro";
import Stamp from "../../components/Stamp.astro";
import { allParts, closedLabel } from "../../lib/catalog";
import { journal } from "../../data/journal.mjs";

// Build log for a safety-gated part: in long-term testing on the founder's car from Sept 20
// (founder direction 2026-09-29), passed on Oct 15 and for sale soon (founder, 2026-10-15). It
// reports the work and the testing. It never offers the part before it is listed, recommends
// installing it, or claims fit or road use for anyone else's car.
const entry = journal.find((item) => item.slug === "wiper-adaptors");
const part = allParts().find((item) => item.slug === entry.partSlug);
if (!part) throw new Error(`journal/${entry.slug}: part ${entry.partSlug} is not in the snapshot`);
const status = closedLabel(part);
const img = (file: string) => `/images/journal/wiper-adaptors/${file}`;
---
<Base title="Build log 002: Modern wiper blades on the original arms — OCP3D"
      image={img("stock-driver-carrier.jpg")}
      imageAlt="The stock driver-side wiper carrier on the founder's 1983 Celica Supra."
      type="article"
      description="Printed adaptors so modern wiper blades run on a 1983 Celica Supra's original arms without drilling them. Passed long-term testing on the car; for sale soon."
      sheet="BUILD LOG 002 · PASSED TESTING">
  <article class="entry-page">
    <div class="wrap entry-wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/journal/">Build logs</a><span>/</span><span>Build log 002</span></nav>

      <ServiceHeading
        eyebrow={entry.eyebrow}
        title="Modern wiper blades on the original arms."
        lede="Printed adaptors so the modern blades from any parts store run on my '83 Supra's original wiper arms, without drilling them. They passed long-term testing on the car."
        file="BUILD LOG 002"
        facts={[["STATUS", status.toUpperCase()], ["TESTED", "SEPT 20 – OCT 15 · ON MY CAR"], ["FOR SALE", "SOON"], ["CAR", "1983 CELICA SUPRA"]]}
      />

      <p class="research-notice" role="note">
        <b>Passed long-term testing.</b> Wipers are safety equipment, so these adaptors were tested on my
        car for vibration, UV exposure, rain and time before I'd offer them to anyone. They went on Sept 20
        and passed on Oct 15. They'll be for sale soon; nothing on this page is for sale yet.
      </p>

      <dl class="entry-facts">
        <div><dt>Car</dt><dd>1983 Toyota Celica Supra (A60)</dd></div>
        <div><dt>Positions</dt><dd>Driver, passenger, rear hatch</dd></div>
        <div><dt>Latest</dt><dd>Revised ASA set, Rain-X blades</dd></div>
        <div><dt>On the car</dt><dd>Since Sept 20; passed testing Oct 15</dd></div>
        <div><dt>Status</dt><dd><Stamp state={part.state} label={status.toUpperCase()} safetyGated /></dd></div>
      </dl>

      <nav class="journey" aria-labelledby="journey-title">
        <p class="eyebrow" id="journey-title">THE JOURNEY SO FAR</p>
        <ol>
          <li><a href="#step-03"><span>Aug 18</span>Nine test pieces for the blade end</a></li>
          <li><a href="#step-05"><span>Aug 19–31</span>Designed the car end for all three arms</a></li>
          <li><a href="#step-04"><span>Aug 24–26</span>Chose the Rain-X connector</a></li>
          <li><a href="#step-06"><span>Sept 5–17</span>Brass inserts, no drilling; moved to ASA</a></li>
          <li><a href="#step-07"><span>Sept 18</span>First fit on the car, and a correction</a></li>
          <li><a href="#step-08"><span>Sept 20</span>Revised set on the car, first powered sweep</a></li>
          <li><a href="#step-09"><span>Sept 20 – Oct 15</span>Long-term testing on the car</a></li>
          <li class="is-now"><a href="#step-09"><span>Oct 15</span>Passed testing; for sale soon</a></li>
        </ol>
      </nav>

      <div class="entry-body">
        <section class="entry-section" id="step-01">
          <p class="step-n">01</p>
          <div class="section-copy">
            <h2>The problem, and the plan</h2>
            <p><strong>On the A60, each front blade clips into a black plastic carrier on the end of the
              arm.</strong> Two screws come through the arm and thread into the carrier, and alignment pins
              and bores keep it square. The carrier holds an old-style blade. The rear uses a plastic U-hook,
              and forty years shows.</p>
            <p><strong>The goal:</strong> run the modern blades you can buy at any parts store on the original
              arms, for all three positions, without drilling or modifying the arms. No dimensions are taken
              from anyone else's adaptor: everything comes from my own calipers on these parts and the published
              blade-connector standards.</p>
            <p><strong>First lesson:</strong> from photos alone, the front carriers looked like a pantograph
              linkage. With the parts in hand, the two holes turned out to be screw holes. Photos show that a
              feature exists, not what it does.</p>
          </div>
          <div class="shots">
            <figure class="shot">
              <img src={img("stock-driver-carrier.jpg")} width="1600" height="1205" loading="lazy"
                   alt="The stock driver-side wiper carrier on the end of the arm, next to a checkerboard scale bar." />
              <figcaption><span>STOCK · DRIVER CARRIER</span><span>AUG 18, 2026</span></figcaption>
            </figure>
            <figure class="shot">
              <img src={img("stock-passenger-carrier.jpg")} width="1600" height="1205" loading="lazy"
                   alt="The stock passenger-side wiper carrier on the arm, next to a checkerboard scale bar." />
              <figcaption><span>STOCK · PASSENGER CARRIER</span><span>AUG 18, 2026</span></figcaption>
            </figure>
            <figure class="shot">
              <img src={img("stock-rear-hook-worn.jpg")} width="1600" height="1205" loading="lazy"
                   alt="Close-up of the worn original rear wiper U-hook." />
              <figcaption><span>STOCK · REAR U-HOOK</span><span>FORTY YEARS OF WEAR</span></figcaption>
            </figure>
          </div>
        </section>

        <section class="entry-section" id="step-02">
          <p class="step-n">02</p>
          <div class="section-copy">
            <h2>Let the shape do the work</h2>
            <p>Plastic is roughly a hundred times less stiff than steel. A flat plastic plate would need to be
              about 12 mm thick to match a thin steel one, and there's no room for that between the arm and the
              glass. So the shape has to carry it: a 12 × 8 mm box with 2.4 mm walls is about 26 times stiffer
              than a 12 mm-wide plate 2.66 mm thick. Printing makes that kind of shape possible where a flat cut
              part can't have it.</p>
          </div>
        </section>

        <section class="entry-section" id="step-03">
          <p class="step-n">03</p>
          <div class="section-copy">
            <h2>The blade end: nine test pieces (Aug 18)</h2>
            <p>Modern blades clip onto a handful of standard arm ends. The common one in the US is the J-hook:
              a 9 mm-wide bar, 3 or 4 mm thick, curled over. I printed nine test pieces at the published
              dimensions, in PLA:</p>
            <ul class="ticks">
              <li>J-hooks, 9 × 3 and 9 × 4 (two of each)</li>
              <li>side pins, 3/16 in and 1/4 in, plain and grooved</li>
              <li>a bayonet</li>
            </ul>
            <p><strong>The hooks went onto a real Bosch Micro Edge blade connector.</strong> Both fit, and the
              9 × 4 felt more solid. The printed width measured 9.00 mm, right on the number.</p>
            <p><strong>Small lesson:</strong> the second insertion was easier than the first. That's PLA yielding
              on the first push, so the fit really was a hair tight. The usual suspect is the thickness, which
              the nozzle's extrusion width sets, rather than the width, which the stacked layers set.</p>
          </div>
          <figure class="shot shot--cad">
            <img src={img("cad-nine-test-pieces.png")} width="800" height="600" loading="lazy"
                 alt="CAD render of nine labelled test pieces: two 9 × 3 J-hooks, two 9 × 4 J-hooks, four side pins, and a bayonet." />
            <figcaption><span>CAD RENDER · TEST PIECES</span><span>NOT A PRODUCT</span></figcaption>
          </figure>
        </section>

        <section class="entry-section" id="step-04">
          <p class="step-n">04</p>
          <div class="section-copy">
            <h2>The blade I actually wanted to run (Aug 24 to 26)</h2>
            <p><strong>The blade I bought for the car, a Rain-X Latitude, didn't latch on my J-hook.</strong>
              The hook went in, but the connector's clip wouldn't close over it. I tried two routes side by
              side: narrowing the hook, and building the arm style the connector was made for.</p>
            <p><strong>The hook route gave me a mistake worth sharing.</strong> I printed a ladder of hook
              widths stepping 0.15 mm apart, and the rungs came out essentially the same width:</p>
            <ul class="ticks">
              <li>the steps were smaller than the 0.20 mm layers on that axis, so the printer couldn't draw
                them</li>
              <li>the narrow section sat over an unsupported bridge that sagged</li>
            </ul>
            <p>It probably cost me the blade's retaining tabs, too.</p>
            <p><strong>The other route won.</strong> The Rain-X connector is designed to fit several arm styles.
              One of them is a U-channel arm end with a window that the connector's push tab snaps up into, so
              the adaptor's blade end became that U-channel.</p>
            <ul class="ticks">
              <li><strong>The gauge beat the calipers.</strong> Calipers gave me 18.55 mm for the connector
                housing, and later 18.84. A printed ladder of collars, plus a coupon that checks the printer's
                own offset (it read 10.00 on 10.00, so no correction), said the 18.35 mm collar fit best, with
                room to spare. Neither caliper reading could be right: an 18.35 mm channel can't slide over an
                18.84 mm housing. I'd been measuring the wrong spot.</li>
              <li><strong>The deciding number was one I'd never measured.</strong> Short printed arm ends
                settled the rest in three rounds, and what decided it was the roof thickness: I'd guessed
                2.5 mm, and 2.0 fit.</li>
              <li><strong>Five tries at the wrong feature.</strong> I spent five attempts designing a press
                button into the channel before research showed the button belongs to the blade's connector.
                The arm end is passive; its window just has to catch the tab.</li>
            </ul>
          </div>
        </section>

        <section class="entry-section" id="step-05">
          <p class="step-n">05</p>
          <div class="section-copy">
            <h2>The car end, and all three adaptors (Aug 19 to 31)</h2>
            <p><strong>Printed gauges measured the arm ends too.</strong> The gauge below plugs into the two
              holes I already knew and puts a numbered window over the ones I didn't. It showed the driver-side
              hole pattern is a dog-leg, not a straight line. The passenger and rear arms carry a pin of their
              own, so those adaptors need a matching hole. The passenger and rear pattern plates seated on the
              car on the first try.</p>
            <p><strong>Then full adaptors for all three positions, on one print plate:</strong></p>
            <ul class="ticks">
              <li><strong>Print orientation is decided in the design.</strong> Printed arm-face down, every bolt
                hole comes out vertical and support-free, and the blade channel opens upward.</li>
              <li><strong>The joint took four tries.</strong> The joint between the mounting plate and the blade
                channel had to be strong without blocking the channel ends or the push-tab window.</li>
              <li><strong>The pin came off.</strong> The driver side had an alignment pin standing up from the
                face that sits against the arm. It was the third locator on a part that already had two: a
                tapered bore that locks onto the arm's boss, and two screws. Removing it lets that face print
                flat on the bed. Contact with the bed went from 28 mm² to 1,324 mm², and support points under
                that face went from 1,221 to zero.</li>
            </ul>
          </div>
          <div class="shots">
            <figure class="shot shot--portrait">
              <img src={img("printed-registration-gauge.jpg")} width="1205" height="1600" loading="lazy"
                   alt="A white printed registration gauge with a numbered window laid over the black stock carrier plate." />
              <figcaption><span>PRINTED GAUGE · OVER THE CARRIER</span><span>AUG 19, 2026</span></figcaption>
            </figure>
            <figure class="shot shot--portrait">
              <img src={img("calipers-on-the-holder.jpg")} width="1205" height="1600" loading="lazy"
                   alt="Digital calipers measuring the blade holder on the stock wiper." />
              <figcaption><span>CALIPERS · STOCK HOLDER</span><span>AUG 19, 2026</span></figcaption>
            </figure>
            <figure class="shot shot--cad-tile">
              <img src={img("cad-current-research-geometry.png")} width="800" height="600" loading="lazy"
                   alt="CAD render of the current research geometry for the three adaptors: a driver plate with its U-channel, and two U-channels for passenger and rear." />
              <figcaption><span>CAD RENDER · CURRENT RESEARCH GEOMETRY</span><span>NOT A PRODUCT</span></figcaption>
            </figure>
          </div>
        </section>

        <section class="entry-section" id="step-06">
          <p class="step-n">06</p>
          <div class="section-copy">
            <h2>Screws, inserts and material (Sept 5 to 17)</h2>
            <p><strong>Screws.</strong> The arm's original screw holes are 3.4 and 3.8 mm, so an M4 screw won't
              pass either one and M3 is the ceiling. I won't drill the arms. The thread used to live in the
              plastic carrier, so the adaptor gets brass M3 heat-set inserts. Small test coupons picked the hole
              size for them: 4.1 mm.</p>
            <p><strong>Material.</strong> PLA is for fit prototypes. The research parts move to ASA, which is
              UV-stable, handles heat, and needs the enclosed printer with the chamber warmed up. The ASA set is
              sliced with 4 walls and 40% infill, because the walls around the inserts carry the clamping load.</p>
          </div>
        </section>

        <section class="entry-section" id="step-07">
          <p class="step-n">07</p>
          <div class="section-copy">
            <h2>First fit, and a correction (Sept 18)</h2>
            <p><strong>The first ASA set went on the car on Sept 18.</strong> Measured against the original
              blades, the new ones sat off to one side: the passenger blade about 15 mm and the driver blade
              about 31 mm toward the passenger side, and the driver blade lifted about 5 mm in the middle.</p>
            <p><strong>The fix:</strong> move the blade mount on both front adaptors to where the original
              carriers hold the blade, and lower the driver side. The revised set went to the printer that
              night.</p>
          </div>
        </section>

        <section class="entry-section" id="step-08">
          <p class="step-n">08</p>
          <div class="section-copy">
            <h2>On the car (Sept 20)</h2>
            <p><strong>The revised ASA set is on the car,</strong> with Rain-X blades clipped into the
              printed adaptors on the original arms. The arms weren't drilled or modified. The clip below is a
              first powered sweep with the car parked.</p>
          </div>
          <figure class="shot shot--wide">
            <video src="/video/journal/wiper-sweep-sept20.mp4" poster={img("sweep-poster.jpg")}
                   width="1280" height="900" controls muted playsinline preload="none"
                   aria-label="Silent clip from the driver's seat: both front blades sweep the windshield on the printed adaptors, car parked."></video>
            <figcaption><span>POWERED SWEEP · CAR PARKED · SEPT 20, 2026</span><span>SILENT CLIP · 14 S</span></figcaption>
          </figure>
          <div class="shots">
            <figure class="shot">
              <img src={img("on-car-adaptor-closeup.jpg")} width="1600" height="900" loading="lazy"
                   alt="Close-up of a printed adaptor on the original arm, holding the Rain-X blade connector." />
              <figcaption><span>ADAPTOR + RAIN-X CONNECTOR</span><span>SEPT 20, 2026</span></figcaption>
            </figure>
            <figure class="shot shot--portrait">
              <img src={img("on-car-adaptor-on-arm.jpg")} width="900" height="1600" loading="lazy"
                   alt="A printed adaptor mounted on the end of the original wiper arm, with the blade attached." />
              <figcaption><span>ON THE ORIGINAL ARM</span><span>SEPT 20, 2026</span></figcaption>
            </figure>
            <figure class="shot shot--portrait">
              <img src={img("on-car-blade-along-cowl.jpg")} width="900" height="1600" loading="lazy"
                   alt="A modern blade resting along the windshield on its printed adaptor, next to the red hood." />
              <figcaption><span>BLADE AT REST</span><span>SEPT 20, 2026</span></figcaption>
            </figure>
          </div>
        </section>

        <section class="entry-section" id="step-09">
          <p class="step-n">09</p>
          <div class="section-copy">
            <h2>Where it stands</h2>
            <ul class="ticks">
              <li><strong>Passed long-term testing</strong> on my car: on since Sept 20, passed Oct 15.</li>
              <li><strong>What it had to prove:</strong> the full sweep at speed, wet and dry, heat, UV, vibration
                and time. This is the first part I've worked on where "it fits" wasn't close to enough.</li>
              <li><strong>Next:</strong> for sale soon. Email updates will say when.</li>
            </ul>
          </div>
        </section>
      </div>

      <aside class="evidence-note">
        <div>
          <p class="eyebrow">PASSED TESTING</p>
          <p>For sale soon. Email updates will say when they're listed, and new photos and video will be added
            here.</p>
        </div>
        <div class="note-actions">
          <a class="btn btn--primary" href="/#register">Get email updates</a>
          <a class="btn btn--secondary" href={`/registry/${part.slug}/`}>See the part record</a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .entry-page { background: linear-gradient(180deg, color-mix(in srgb, var(--ground-deep) 28%, transparent), transparent 32%); }
  .entry-wrap { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-size: var(--t-eyebrow); color: var(--steel); text-transform: uppercase; letter-spacing: .1em; }
  .crumbs a { color: var(--ion); }

  .research-notice { padding: 15px 18px; border: var(--bd-inner) solid var(--signal); border-left-width: 4px; background: color-mix(in srgb, var(--signal) 8%, var(--ground)); color: var(--body); font-size: var(--t-dense); line-height: var(--t-dense-lh); }
  .research-notice b { color: var(--signal); }

  figcaption { display: flex; justify-content: space-between; gap: 8px 14px; flex-wrap: wrap; padding: 10px 14px; border-top: var(--bd-inner) solid var(--rule); font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); color: var(--steel); }

  .journey { padding: 18px 22px 20px; border: var(--bd-inner) solid var(--rule-2); background: var(--panel); }
  .journey ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(126px, 1fr)); gap: 10px 14px; margin: 12px 0 0; padding: 0; list-style: none; }
  .journey li a { display: grid; gap: 4px; height: 100%; padding: 10px 12px; border-left: 3px solid var(--rule); color: var(--paper); font-family: var(--font-text); font-size: var(--t-dense); line-height: 1.35; }
  .journey li a:hover { border-color: var(--ion); color: var(--ion); }
  .journey li span { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; color: var(--steel); }
  .journey .is-now a { border-color: var(--st-closed); background: color-mix(in srgb, var(--acid) 18%, transparent); font-weight: 600; }
  .entry-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin: 0; border-top: var(--bd-inner) solid var(--rule); border-left: var(--bd-inner) solid var(--rule); background: var(--ground); }
  .entry-facts > div { padding: 14px 16px; border-right: var(--bd-inner) solid var(--rule); border-bottom: var(--bd-inner) solid var(--rule); }
  .entry-facts dt { font-family: var(--font-mono); font-size: var(--t-micro); letter-spacing: var(--t-micro-tr); text-transform: uppercase; color: var(--steel); }
  .entry-facts dd { margin: 5px 0 0; color: var(--paper); font-size: var(--t-dense); line-height: var(--t-dense-lh); }

  .entry-body { border: var(--bd-inner) solid var(--rule-2); background: var(--panel); }
  .entry-section { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 0 16px; padding: 26px 30px; border-top: var(--bd-inner) solid var(--rule); }
  .entry-section:first-child { border-top: 0; }
  .entry-section > :not(.step-n) { grid-column: 2; }
  .step-n { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--signal); color: var(--signal); font-family: var(--font-mono); font-size: var(--t-eyebrow); letter-spacing: .08em; }
  .section-copy { max-width: 70ch; }
  .section-copy h2 { font-size: 24px; margin-bottom: 12px; }
  .section-copy p { margin-top: 12px; color: var(--body); }
  .section-copy h2 + p { margin-top: 0; }
  .section-copy strong { color: var(--paper); }
  .ticks { display: grid; gap: 7px; margin-top: 10px; color: var(--body); }
  .ticks li { position: relative; padding-left: 18px; }
  .ticks li::before { content: ""; position: absolute; left: 0; top: .72em; width: 8px; border-top: 2px solid var(--signal); }

  .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 20px; align-items: start; }
  .shot { margin: 0; border: var(--bd-inner) solid var(--rule); background: var(--ground-deep); min-width: 0; }
  .shot img, .shot video { width: 100%; height: auto; display: block; background: var(--journal-charcoal); }
  .shot--cad { margin-top: 20px; max-width: 520px; }
  .shot--wide { margin-top: 20px; max-width: 760px; }
  .shot--wide video { aspect-ratio: 1280 / 900; }
  .shot--portrait img, .shot--portrait video { aspect-ratio: 3 / 4; object-fit: cover; }
  .shot--cad-tile img { aspect-ratio: 3 / 4; object-fit: contain; }
  .shot--cad img, .shot--cad-tile img { background: #f7f7f7; }

  .evidence-note { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 22px; padding: 22px 26px; border: var(--bd-inner) solid var(--rule); background: color-mix(in srgb, var(--ground-deep) 84%, transparent); }
  .evidence-note p:not(.eyebrow) { margin-top: 7px; color: var(--steel); font-size: var(--t-dense); max-width: 70ch; }
  .note-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .evidence-note { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .entry-section { grid-template-columns: 1fr; padding: 22px 20px; }
    .entry-section > :not(.step-n) { grid-column: 1; }
    .step-n { margin-bottom: 12px; }
    .shots { grid-template-columns: 1fr; }
    .evidence-note { padding: 20px; }
  }
</style>
