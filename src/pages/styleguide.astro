---
import Base from "../layouts/Base.astro";
import Insignia from "../components/Insignia.astro";
import Lockup from "../components/Lockup.astro";

// Wilma: everything on this page is rendered FROM the tokens in
// src/styles/tokens.css. If a swatch here is wrong, the token is wrong.
const colours = [
  ["--ground", "page background — the blueprint blue"],
  ["--ground-deep", "recessed panels, hero pane, inputs"],
  ["--ink", "text on paper/amber, button labels"],
  ["--paper", "all line work, rules, borders, primary text"],
  ["--amber", "THE house colour — one accent only"],
  ["--steel", "secondary/label text, zone markers"],
  ["--body", "body copy on ground"],
  ["--glass", "placeholder captions"],
  ["--rule", "interior hairlines"],
  ["--rule-2", "placeholder borders, table gridlines"],
  ["--rule-3", "faint separators"],
  ["--panel", "placeholder hatch, stripe 1"],
  ["--panel-2", "placeholder hatch, stripe 2"],
  ["--border", "outermost page border"],
];
const type = [
  ["Page H1", "var(--font-display)", "68 / 0.94 / -0.015em", "h1"],
  ["Section H2", "var(--font-display)", "40 / 1.02 / -0.01em", "h2"],
  ["Card title", "var(--font-display)", "15 uppercase", "card"],
  ["Wordmark", "var(--font-word)", "15 or 21, weight 600", "word"],
  ["Lead", "var(--font-mono)", "15 / 1.7", "lead"],
  ["Section body", "var(--font-mono)", "13.5 / 1.75", "sec"],
  ["Dense", "var(--font-mono)", "11.5 / 1.6", "dense"],
  ["Eyebrow", "var(--font-mono)", "10.5 uppercase / 0.16em", "eye"],
  ["Spec value", "var(--font-mono) 600", "15", "spec"],
];
---
<Base title="Styleguide — The Ministry of Discontinued Parts" sheet="STYLEGUIDE">
  <section class="section">
    <p class="eyebrow">SHEET REFERENCE — THE DESIGN SYSTEM</p>
    <h1>The cyanotype.</h1>
    <p class="lead sg-lead">
      Every value on this page comes from <code>src/styles/tokens.css</code> — the single source
      of truth. Components consume tokens and never hard-code a colour or a size. Radius is zero
      everywhere; there are no shadows anywhere on the site; sections are divided by 1px paper
      rules, never by whitespace.
    </p>
  </section>

  <section class="section">
    <p class="eyebrow">THE LOCKUP — SYMBOL, NAME, COLOUR LINE. ONE UNIT.</p>
    <div class="lockups">
      <div><Lockup variant="landscape" /><p class="dense cap">Landscape · header, screen</p></div>
      <div><Lockup variant="portrait" /><p class="dense cap">Portrait · print, stationery</p></div>
      <div class="avatar-demo">
        <span class="avatar"><Insignia size={32} knockout="var(--ink)" /></span>
        <p class="dense cap">Avatar · social, favicon</p>
      </div>
    </div>
    <p class="dense note">
      Never restyle the three parts independently. Line breaks are fixed — two lines landscape,
      three portrait, never one. Mixed case, never all caps, never italic. Below 26px the shield
      closes up: use the car alone.
    </p>
  </section>

  <section class="section">
    <p class="eyebrow">COLOUR</p>
    <div class="swatches">
      {colours.map(([tok, use]) => (
        <div class="sw">
          <span class="chip-c" style={`background: var(${tok})`}></span>
          <code>{tok}</code>
          <span class="dense">{use}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">TYPE — TWO FAMILIES, SELF-HOSTED</p>
    <div class="hairline-grid type-grid">
      {type.map(([role, fam, size, cls]) => (
        <>
          <div><span class="eyebrow">{role}</span></div>
          <div><span class={`sample s-${cls}`}>Discontinued</span></div>
          <div><span class="dense">{fam}</span></div>
          <div><span class="dense">{size}</span></div>
        </>
      ))}
    </div>
    <p class="dense note">
      Monospace is the body voice of the whole site — resist substituting a proportional face for
      "readability". Never reduce mono body copy below 12px.
    </p>
  </section>

  <section class="section">
    <p class="eyebrow">COMPONENTS</p>
    <div class="comp">
      <a class="btn btn--primary" href="#">Primary</a>
      <a class="btn btn--secondary" href="#">Secondary</a>
      <span class="chip chip--amber">20 DIMS RECORDED</span>
      <span class="chip chip--solid">MEASURED</span>
    </div>
    <div class="ph-demo placeholder"><span>PART VIEW</span><small>the standing placeholder for a photograph that is owed</small></div>
  </section>
</Base>

<style>
  .sg-lead { max-width: 640px; }
  code { font-family: var(--font-mono); font-size: var(--t-dense); color: var(--amber); }
  .note { color: var(--steel); margin-top: 14px; max-width: 640px; }
  .cap { color: var(--steel); margin-top: 12px; }

  .lockups { display: flex; gap: 56px; flex-wrap: wrap; align-items: flex-start; margin-top: 18px; }
  .avatar { display: grid; place-items: center; width: 54px; height: 54px; background: var(--ink); }

  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; margin-top: 16px; }
  .sw { display: grid; grid-template-columns: 34px 1fr; gap: 4px 12px; align-items: center; }
  .chip-c { width: 34px; height: 34px; border: 1px solid var(--rule); grid-row: span 2; }
  .sw .dense { color: var(--steel); }

  .type-grid { grid-template-columns: 130px 1fr 210px 150px; margin-top: 16px; }
  .sample { color: var(--paper); }
  .s-h1 { font-family: var(--font-display); font-size: 40px; text-transform: uppercase; }
  .s-h2 { font-family: var(--font-display); font-size: 28px; text-transform: uppercase; }
  .s-card { font-family: var(--font-display); font-size: var(--h-card); text-transform: uppercase; }
  .s-word { font-family: var(--font-word); font-weight: 600; font-size: 21px; }
  .s-lead { font-size: var(--t-lead); }
  .s-sec { font-size: var(--t-section); }
  .s-dense { font-size: var(--t-dense); }
  .s-eye { font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; }
  .s-spec { font-weight: 600; font-size: var(--t-spec); }

  .comp { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin: 16px 0 22px; }
  .chip { font-size: var(--t-eyebrow); letter-spacing: var(--t-eyebrow-tr); text-transform: uppercase; padding: 5px 10px; }
  .chip--amber { border: 1px solid var(--amber); color: var(--amber); }
  .chip--solid { background: var(--paper); color: var(--ink); font-weight: 600; }
  .ph-demo { height: 160px; max-width: 420px; }

  @media (max-width: 720px) { .type-grid { grid-template-columns: 1fr 1fr; } }
</style>
